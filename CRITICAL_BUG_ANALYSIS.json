        "method": "_emit_close",
        "line_range": "108-127",
        "current_behavior": "Emits DEC:CLOSE only, does NOT cancel SL/TP",
        "required_behavior": "Must emit [DEC:CANCEL_SL, DEC:CANCEL_TP, DEC:CLOSE]"
      },
      "partial_occ_implementation": {
        "file": "vfoundation/apps/reference/domains/execution_position/fsm_manage.py",
        "method": "_check_rules",
        "line_range": "386-395",
        "covers": "If TP filled, cancel SL. If SL filled, cancel TP.",
        "missing": "Does NOT handle case where position closes without either SL/TP filling"
      },
      "no_cleanup_on_error": {
        "file": "vfoundation/apps/reference/domains/execution_position/fsm_manage.py",
        "missing_method": "_cleanup_brackets_on_error",
        "trigger": "When main order REJECTED or EXPIRED, brackets are not cleaned"
      }
    },

