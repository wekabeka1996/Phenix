    "blocks_production": true,
    "blocks_mainnet": true,

    "problem": {
      "title": "Accumulation of Orphaned TP/SL Bracket Orders",
      "description": "Binance API treats bracket orders (Market + SL + TP) as 3 separate orders. When positions close, SL/TP orders are not cancelled and remain active on exchange. After ~65 positions, system reaches Binance's 200 order limit and can no longer place new trades.",
      "root_cause": "FSM close_flow and manage_flow do not emit DEC:CANCEL_ORDER for bracket orders when positions are closed",
      "time_to_crash": "2-3 hours of continuous trading",
      "crash_mode": "HARD_FAILURE - API returns error code -1013: Order count limit exceeded"
    },

    "impact": {
      "trading_halted": true,
      "order_placement_blocked": true,
      "affected_timescale_hours": 2.5,
      "approximate_orders_accumulated_at_crash": 210,
      "binance_limit": 200,
      "approximate_position_count_at_crash": 70,
      "orders_per_position": 3
    },

    "failure_scenario": {
      "step_1": "Position #1: Place Market Order (order_id=1) + SL (order_id=2) + TP (order_id=3)",
      "step_2": "Position closes: DEC:CLOSE emitted, market order cancelled/filled, SL remains PENDING, TP remains PENDING",
      "step_3": "Orders accumulated: 3 (market done) + 2 (orphaned SL+TP) = effective +2 per position",
      "step_4": "After 65 positions: ~3 + (64 × 3) + (10 accumulated SL/TP) = ~203 orders",
      "step_5": "Position 66 attempt: API error 'Order count limit exceeded', trading halts"
    },

    "code_locations": {
      "where_brackets_placed": {
        "file": "vfoundation/apps/reference/domains/execution_position/fsm_manage.py",
        "method": "_place_brackets",
        "line_range": "180-250",
        "stores": ["sl_order_id", "tp_order_id"]
      },
      "where_close_should_clean": {
