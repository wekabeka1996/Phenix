# =============================================================================
# Optimizer Configuration — Aurora Hierarchical Optimization
# =============================================================================

# Optuna study settings
optuna:
  sampler: TPE                 # Tree-structured Parzen Estimator
  storage: "sqlite:///optimization_studies.db"
  pruner:
    type: MedianPruner
    n_startup_trials: 5
    n_warmup_steps: 3

# Stage 0: Regime Calibration
stage0:
  n_trials: 50
  study_name_prefix: "aurora_regime"
  # Outer grid: basis_tf_sec values to iterate over
  # Each value gets its own Optuna study; best stability_score across grids wins
  outer_grid:
    basis_tf_sec: [60, 180, 300, 900]
  acceptance:
    min_stability_score: 0.3   # Minimum acceptable stability_score
    min_definite_ratio: 0.5    # At least 50% of bars must be definite regime

# Stage 1: Alpha Search
stage1:
  n_trials: 50
  study_name_prefix: "aurora_alpha"
  acceptance:
    min_sharpe: 0.5            # Minimum Sharpe ratio
    max_dd_pct: 35.0           # Hard reject above this drawdown

# Stage 2: Robustness Check
stage2:
  walk_forward:
    train_pct: 0.60
    gap_pct: 0.10
    test_pct: 0.30
    n_folds: 5                 # Rolling folds
  block_bootstrap:
    n_resamples: 100
    block_size_bars: 30        # ~2.5 hours at 5m bars
    confidence_level: 0.95
  execution_stress:
    latency_ms_range: [50, 500]
    slippage_bps_range: [1, 10]
    fee_multiplier_range: [1.0, 1.5]
  acceptance:
    min_median_sharpe: 0.3     # Median Sharpe across WF folds
    max_sharpe_degradation: 0.5  # Max drop from Stage 1 Sharpe
    bootstrap_pnl_positive_pct: 0.80  # 80%+ of bootstrap samples must be profitable

# Cold Holdout (final go/no-go gate)
holdout:
  # Reserve last N months of data — NEVER seen during S0/S1/S2
  reserve_months: 3
  acceptance:
    min_sharpe: 1.0
    max_mdd_p90_pct: 25.0     # 90th-percentile MDD must be under 25%

# Data settings
data:
  symbols: ["BTCUSDT"]
  # Timeframe for backtests (must match available data)
  timeframe: "5m"
