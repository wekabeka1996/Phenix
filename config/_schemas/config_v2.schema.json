{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.scalp/shared/config/config_v2.schema.json",
  "title": "AuroraConfigV2",
  "type": "object",
  "properties": {
    "core": {
      "type": ["object", "null"],
      "description": "Optional shared settings that overlay system defaults."
    },
    "symbols": {
      "type": ["object", "null"],
      "description": "Optional symbol-level overrides that complement instruments."
    },
    "instruments": {
      "type": ["object", "null"],
      "description": "Definitions of supported instruments (precision, limits, defaults). Null means no custom instruments."
    },
    "overrides": {
      "type": ["object", "null"],
      "description": "Explicit override blocks (symbols, domains, etc.). Null is equivalent to empty object."
    },
    "modes": {
      "type": ["object", "null"],
      "description": "Trading mode profiles and domain mode maps. Null means default mode.",
      "properties": {
        "profiles": {
          "type": "object",
          "description": "Named trading profiles with domain-mode mappings."
        }
      },
      "additionalProperties": true
    },
    "domains": {
      "type": "object",
      "description": "Domain-specific configuration fragments.",
      "properties": {
        "execution": {
          "type": "object",
          "properties": {
            "exposure": {
              "type": "object",
              "properties": {
                "max_equity_utilization_pct": {
                  "type": "number",
                  "description": "High-level exposure cap."
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "risk": {
          "type": "object"
        },
        "decision": {
          "type": "object"
        },
        "sizing": {
          "type": "object"
        },
        "features": {
          "type": "object"
        },
        "regimes": {
          "type": "object"
        },
        "tca": {
          "type": ["object", "null"]
        }
      },
      "required": [
        "execution",
        "risk",
        "decision",
        "sizing",
        "features",
        "regimes"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "domains"
  ],
  "additionalProperties": true
}
