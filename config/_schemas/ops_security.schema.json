{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.scalp/shared/config/ops_security.schema.json",
  "title": "OpsSecurityConfig",
  "type": "object",
  "required": [
    "config_version",
    "mtls",
    "algorithms",
    "acl",
    "keys"
  ],
  "additionalProperties": false,
  "properties": {
    "config_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "mtls": {
      "type": "object",
      "required": [
        "enabled",
        "client_cert_path",
        "client_key_path",
        "ca_bundle_path",
        "renewal_days"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "client_cert_path": {
          "type": "string",
          "minLength": 1
        },
        "client_key_path": {
          "type": "string",
          "minLength": 1
        },
        "ca_bundle_path": {
          "type": "string",
          "minLength": 1
        },
        "renewal_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "algorithms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "Ed25519",
          "ES256"
        ]
      },
      "uniqueItems": true
    },
    "alg": {
      "type": "string",
      "enum": [
        "Ed25519",
        "ES256"
      ],
      "description": "Preferred algorithm for signing envelopes"
    },
    "dev_hmac_allowed": {
      "type": "boolean",
      "description": "Allow dev HMAC fallback when signing keys are missing"
    },
    "acl": {
      "type": "object",
      "required": [
        "topics"
      ],
      "additionalProperties": false,
      "properties": {
        "topics": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "produce",
              "consume"
            ],
            "additionalProperties": false,
            "properties": {
              "produce": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "consume": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "keys": {
      "type": "object",
      "required": [
        "active_kid",
        "rollover_window_h",
        "grace_h"
      ],
      "additionalProperties": false,
      "properties": {
        "active_kid": {
          "type": "string",
          "minLength": 4
        },
        "rollover_window_h": {
          "type": "integer",
          "minimum": 1
        },
        "grace_h": {
          "type": "integer",
          "minimum": 0
        },
        "hmac_secret": {
          "type": "string",
          "description": "Optional dev/test HMAC secret for non-prod signing fallback"
        },
        "kid": {
          "type": "string",
          "minLength": 4
        },
        "public_key_pem": {
          "type": "string"
        },
        "private_key_pem": {
          "type": "string",
          "deprecated": true,
          "description": "DEPRECATED: Use private_key instead"
        },
        "private_key": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "pem_path": {
                  "type": "string",
                  "description": "Filesystem path to PEM private key file"
                }
              },
              "required": [
                "pem_path"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "pem_b64": {
                  "type": "string",
                  "description": "Base64-encoded PEM private key content"
                }
              },
              "required": [
                "pem_b64"
              ],
              "additionalProperties": false
            }
          ],
          "description": "Private key specification (either file path or base64 content)"
        },
        "certificate": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "pem_path": {
                  "type": "string",
                  "description": "Filesystem path to PEM certificate file"
                }
              },
              "required": [
                "pem_path"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "pem_b64": {
                  "type": "string",
                  "description": "Base64-encoded PEM certificate content"
                }
              },
              "required": [
                "pem_b64"
              ],
              "additionalProperties": false
            }
          ],
          "description": "Certificate specification (either file path or base64 content)"
        },
        "password_b64": {
          "type": "string",
          "description": "Base64-encoded password for encrypted private keys"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dev_hmac_allowed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "keys": {
            "required": [
              "hmac_secret"
            ]
          }
        }
      }
    }
  ]
}
