{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.scalp/shared/config/ops_dr.schema.json",
  "title": "OpsDRConfig",
  "type": "object",
  "required": ["config_version", "targets", "backup", "failover", "tests"],
  "additionalProperties": false,
  "properties": {
    "config_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "targets": {
      "type": "object",
      "required": ["rpo_seconds", "rto_minutes"],
      "additionalProperties": false,
      "properties": {
        "rpo_seconds": {"type": "integer", "minimum": 0},
        "rto_minutes": {"type": "integer", "minimum": 1}
      }
    },
    "backup": {
      "type": "object",
      "required": ["interval_seconds", "targets", "journal_topic"],
      "additionalProperties": false,
      "properties": {
        "interval_seconds": {"type": "integer", "minimum": 1},
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "journal_topic": {"type": "string", "minLength": 1}
      }
    },
    "failover": {
      "type": "object",
      "required": ["steps"],
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "objective"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
