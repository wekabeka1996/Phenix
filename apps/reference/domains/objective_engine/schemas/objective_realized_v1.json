{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aurora.internal/schemas/objective_engine/objective_realized_v1.json",
  "title": "ObjectiveRealizedEvent v1",
  "description": "Typed realized-objective event emitted by the objective engine after a position closes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "strategy_id",
    "symbol",
    "entry_rid",
    "close_rid",
    "regime_entry",
    "regime_exit",
    "pretrade_objective_trace",
    "realized_components",
    "realized_quality_score",
    "realized_pnl",
    "fees",
    "duration_sec",
    "mae",
    "mfe",
    "close_reason"
  ],
  "properties": {
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "entry_rid": {
      "type": "string",
      "minLength": 1
    },
    "close_rid": {
      "type": "string",
      "minLength": 1
    },
    "regime_entry": {
      "type": "string",
      "minLength": 1
    },
    "regime_exit": {
      "type": "string",
      "minLength": 1
    },
    "pretrade_objective_trace": {
      "type": "object",
      "additionalProperties": true
    },
    "realized_components": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "realized_quality_score": {
      "type": "number"
    },
    "realized_pnl": {
      "type": "number"
    },
    "fees": {
      "type": "number"
    },
    "duration_sec": {
      "type": "number"
    },
    "mae": {
      "type": "number"
    },
    "mfe": {
      "type": "number"
    },
    "close_reason": {
      "type": "string",
      "minLength": 1
    },
    "signal_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
