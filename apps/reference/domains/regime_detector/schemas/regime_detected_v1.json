{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aurora-core.io/schemas/regime_detected_v1.json",
  "title": "RegimeDetectedEvent_v1",
  "description": "Signals the detection of a specific market regime.",
  "type": "object",
  "properties": {
    "ts": {
      "type": "integer",
      "description": "Event timestamp (microseconds).",
      "minimum": 0
    },
    "symbol": {
      "type": "string",
      "description": "The symbol for which the regime was detected, e.g., 'ETHUSDT'.",
      "pattern": "^[A-Z0-9]+$",
      "minLength": 2,
      "maxLength": 20
    },
    "ts_ms": {
      "type": "integer",
      "description": "Legacy/additive millisecond alias for ts.",
      "minimum": 0
    },
    "regime": {
      "type": "string",
      "enum": [
        "TREND_UP",
        "TREND_DOWN",
        "MEAN_REVERSION",
        "HIGH_VOLATILITY",
        "LOW_VOLATILITY",
        "UNCERTAIN"
      ],
      "description": "The identified market regime."
    },
    "confidence": {
      "type": "string",
      "description": "A string-encoded Decimal representing the confidence in the detection (0.0 to 1.0).",
      "pattern": "^(0(\\.\\d+)?|1(\\.0+)?)$"
    },
    "source_model": {
      "type": "string",
      "description": "The name of the model used for detection, e.g., 'HMM_v1'.",
      "minLength": 1,
      "maxLength": 50
    },
    "regime_layer": {
      "type": "string",
      "enum": [
        "structural",
        "execution_micro",
        "global_backdrop"
      ]
    },
    "regime_scope": {
      "type": "string",
      "enum": [
        "per_symbol",
        "global"
      ]
    },
    "regime_clock": {
      "type": "string",
      "enum": [
        "bar",
        "event_driven"
      ]
    },
    "regime_owner": {
      "type": "string"
    },
    "structural_regime_ref": {
      "type": "string"
    },
    "warmup": {
      "type": "object",
      "description": "Warmup/readiness state for RegimeDetector (TASK24 additive)",
      "properties": {
        "full_ready": {
          "type": "boolean"
        },
        "ticks_seen": {
          "type": "integer"
        },
        "ready": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "full_ready",
        "ticks_seen"
      ],
      "additionalProperties": false
    },
    "data_quality": {
      "type": "object",
      "description": "Data-quality signals for regime detection (TASK24 additive)",
      "properties": {
        "drops": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "drops"
      ],
      "additionalProperties": false
    },
    "changed": {
      "type": "boolean",
      "description": "DM-CRITICAL-PATCHES-02: True if regime changed from previous, False if heartbeat only"
    },
    "last_update_ts_ms": {
      "type": "integer",
      "description": "DM-CRITICAL-PATCHES-02: Heartbeat timestamp (monotonic ms) for liveness check",
      "minimum": 0
    },
    "calc_lag_ms": {
      "type": "number",
      "description": "Calculation lag in milliseconds (debug/diagnostic)"
    },
    "hysteresis_confirm_count": {
      "type": "integer",
      "description": "Hysteresis confirmation bar count"
    },
    "raw_confidence": {
      "type": [
        "number",
        "string",
        "null"
      ],
      "description": "Raw unsmoothed confidence before hysteresis"
    },
    "raw_regime": {
      "type": [
        "string",
        "null"
      ],
      "description": "Raw regime before hysteresis smoothing"
    },
    "stable_confidence": {
      "type": [
        "number",
        "string",
        "null"
      ],
      "description": "Confidence with smoothing applied"
    },
    "storm_rejected": {
      "type": "boolean",
      "description": "True if regime was rejected due to volatility storm gate"
    },
    "vol_ratio": {
      "type": [
        "number",
        "string",
        "null"
      ],
      "description": "Volatility ratio used for regime detection"
    },
    "vol_ratio_slope": {
      "type": [
        "number",
        "string",
        "null"
      ],
      "description": "Slope of the volatility ratio"
    }
  },
  "required": [
    "ts",
    "symbol",
    "regime",
    "confidence",
    "source_model"
  ],
  "additionalProperties": true
}
