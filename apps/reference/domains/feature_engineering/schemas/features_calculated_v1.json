{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "features_calculated_v1.json",
  "title": "Bar Features Calculated Event",
  "description": "Schema for EVT:FEATURES_CALCULATED event payload (bar-only contract)",
  "type": "object",
  "properties": {
    "ts": {
      "type": "integer",
      "description": "Timestamp of feature calculation in milliseconds epoch"
    },
    "symbol": {
      "type": "string",
      "description": "Trading instrument symbol (e.g., 'BTCUSDT')"
    },
    "tf_sec": {
      "type": "integer",
      "minimum": 60,
      "maximum": 3600,
      "description": "Bar timeframe in seconds for bar aggregation (e.g., 180 for 3m bars). Tick features use EVT:TICK_FEATURES_CALCULATED."
    },
    "warmup": {
      "type": "object",
      "description": "Warmup/readiness state for feature engineering (TASK24, fail-closed upstream)",
      "properties": {
        "full_ready": {
          "type": "boolean"
        },
        "ticks_seen": {
          "type": "integer"
        },
        "ready": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "full_ready",
        "ticks_seen"
      ],
      "additionalProperties": true
    },
    "features": {
      "type": "object",
      "description": "Calculated features object",
      "properties": {
        "obi": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?(E[+-]?[0-9]+)?$",
          "description": "Order Book Imbalance [-1, 1] (string-encoded Decimal)"
        },
        "tfi": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?(E[+-]?[0-9]+)?$",
          "description": "Trade Flow Imbalance [-1, 1] (string-encoded Decimal)"
        },
        "delta_price": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?(E[+-]?[0-9]+)?$",
          "description": "Price change delta, filtered if time gap > 5s (string-encoded Decimal)"
        },
        "absorption": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?(E[+-]?[0-9]+)?$",
          "description": "Market absorption indicator - placeholder, always '0.0'"
        },
        "price": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Current price (string-encoded Decimal)"
        },
        "liquidity_kappa": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Normalized liquidity [0.3, 1.0] (string-encoded Decimal)"
        },
        "ema_bias": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?(E[+-]?[0-9]+)?$",
          "description": "EMA3/EMA7 trend bias normalized to [0, 1] (Phase 1)"
        },
        "volume_spike": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?(E[+-]?[0-9]+)?$",
          "description": "Volume spike ratio normalized to [0, 1] (Phase 1)"
        },
        "volatility_state": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?(E[+-]?[0-9]+)?$",
          "description": "Current vs historical volatility [0, 1] (Phase 1)"
        },
        "depth_imbalance": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?(E[+-]?[0-9]+)?$",
          "description": "Depth imbalance normalized to [0, 1] (Phase 1)"
        },
        "macro_sync": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?(E[+-]?[0-9]+)?$",
          "description": "Correlation with anchor symbols (BTC/ETH) [0, 1] (Phase 1)"
        }
      },
      "required": [
        "obi",
        "tfi",
        "delta_price",
        "absorption"
      ],
      "additionalProperties": true
    },
    "price_motion": {
      "type": "object",
      "description": "Additive-only block: multi-window returns/volatility proxy and normalized price motion (fractional returns).",
      "additionalProperties": true,
      "properties": {
        "ret_10s": {
          "type": [
            "number",
            "null"
          ]
        },
        "ret_60s": {
          "type": [
            "number",
            "null"
          ]
        },
        "ret_300s": {
          "type": [
            "number",
            "null"
          ]
        },
        "vol_pct_10s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "vol_pct_60s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "vol_pct_300s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "pm_norm_10s": {
          "type": [
            "number",
            "null"
          ]
        },
        "pm_norm_60s": {
          "type": [
            "number",
            "null"
          ]
        },
        "pm_norm_300s": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "ret_10s",
        "ret_60s",
        "ret_300s"
      ]
    },
    "bar": {
      "type": "object",
      "description": "Raw OHLCV bar data required by the bar-only feature contract. Shape from bar_closed_v1.json.",
      "required": [
        "symbol",
        "timeframe_sec",
        "start_ts_ms",
        "end_ts_ms",
        "open",
        "high",
        "low",
        "close",
        "volume"
      ],
      "properties": {
        "symbol": {
          "type": "string"
        },
        "timeframe_sec": {
          "type": "integer",
          "minimum": 1
        },
        "start_ts_ms": {
          "type": "integer"
        },
        "end_ts_ms": {
          "type": "integer"
        },
        "open": {
          "type": "string"
        },
        "high": {
          "type": "string"
        },
        "low": {
          "type": "string"
        },
        "close": {
          "type": "string"
        },
        "volume": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "source_mode": {
      "type": "string",
      "description": "Bar/tick source mode (live, replay, warmup_import, synthetic_repair)",
      "enum": [
        "live",
        "replay",
        "warmup_import",
        "synthetic_repair"
      ]
    },
    "trade_flow_state": {
      "type": ["string", "null"],
      "enum": ["unknown", "fresh", "degraded", "stale", null],
      "description": "Trade-flow freshness state propagated from market_data"
    },
    "trade_flow_age_ms": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Age of the latest observed trade in milliseconds"
    },
    "trade_flow_last_trade_ts_ms": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Exchange timestamp of the latest observed trade"
    },
    "trade_flow_window_sec": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Trade-flow aggregation window in seconds"
    },
    "regime": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional regime snapshot attached by upstream code. FeatureEngineering does not require it for bar feature emission.",
      "additionalProperties": true
    },
    "diagnostics": {
      "type": "object",
      "description": "FE internal diagnostics snapshot: emission counters, anchor intake, warmup state.",
      "additionalProperties": true
    },
    "bar_identity": {
      "type": "object",
      "description": "Canonical bar identity (symbol, timeframe_sec, bar_start_ts_ms, bar_end_ts_ms, close_boundary_ts_ms, source_mode). Present only for bar-level events.",
      "additionalProperties": true
    },
    "close_boundary_ts_ms": {
      "type": "integer",
      "description": "Canonical close boundary timestamp in milliseconds epoch. Present only for bar-level events.",
      "minimum": 1
    },
    "replay_identity": {
      "type": "object",
      "description": "Replay identity envelope (symbol, timeframe_sec, close_boundary_ts_ms, source_mode, replay_generation). Present only in replay mode.",
      "additionalProperties": true
    },
    "replay_generation": {
      "type": "integer",
      "description": "Replay generation counter. Present only in replay mode.",
      "minimum": 0
    },
    "gap_state": {
      "type": "string",
      "enum": [
        "CLEAR",
        "GAP_DETECTED",
        "REPAIRED",
        "INVALIDATED"
      ]
    },
    "gap_policy_action": {
      "type": "string",
      "enum": [
        "NONE",
        "REPAIR",
        "INVALIDATE",
        "DEGRADE_TO_NON_TRADING"
      ]
    },
    "gap_bars_skipped": {
      "type": "integer",
      "minimum": 0
    },
    "is_gap_bar": {
      "type": "boolean"
    },
    "gap": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "ts",
    "symbol",
    "tf_sec",
    "features",
    "warmup",
    "price_motion",
    "bar",
    "source_mode",
    "diagnostics"
  ],
  "additionalProperties": false
}
