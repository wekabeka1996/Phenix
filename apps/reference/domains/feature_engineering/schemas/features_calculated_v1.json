{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "features_calculated_v1.json",
  "title": "Features Calculated Event",
  "description": "Schema for EVT:FEATURES_CALCULATED event payload",
  "type": "object",
  "properties": {
    "ts": {
      "type": "integer",
      "description": "Timestamp of feature calculation in milliseconds epoch"
    },
    "symbol": {
      "type": "string",
      "description": "Trading instrument symbol (e.g., 'BTCUSDT')"
    },
    "tf_sec": {
      "type": "integer",
      "minimum": 60,
      "maximum": 3600,
      "description": "Timeframe in seconds for bar aggregation (e.g., 180 for 3m bars)"
    },
    "warmup": {
      "type": "object",
      "description": "Warmup/readiness state for feature engineering (TASK24, fail-closed upstream)",
      "properties": {
        "full_ready": { "type": "boolean" },
        "ticks_seen": { "type": "integer" },
        "ready": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["full_ready", "ticks_seen"],
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "description": "Calculated features object",
      "properties": {
        "obi": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "description": "Order Book Imbalance [-1, 1] (string-encoded Decimal)"
        },
        "tfi": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "description": "Trade Flow Imbalance [-1, 1] (string-encoded Decimal)"
        },
        "delta_price": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "description": "Price change delta, filtered if time gap > 5s (string-encoded Decimal)"
        },
        "absorption": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
          "description": "Market absorption indicator - placeholder, always '0.0'"
        },
        "price": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Current price (string-encoded Decimal)"
        },
        "liquidity_kappa": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Normalized liquidity [0.3, 1.0] (string-encoded Decimal)"
        },
        "ema_bias": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "EMA3/EMA7 trend bias normalized to [0, 1] (Phase 1)"
        },
        "volume_spike": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Volume spike ratio normalized to [0, 1] (Phase 1)"
        },
        "volatility_state": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Current vs historical volatility [0, 1] (Phase 1)"
        },
        "depth_imbalance": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Depth imbalance normalized to [0, 1] (Phase 1)"
        },
        "macro_sync": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Correlation with anchor symbols (BTC/ETH) [0, 1] (Phase 1)"
        }
      },
      "required": ["obi", "tfi", "delta_price", "absorption"],
      "additionalProperties": true
    },
    "price_motion": {
      "type": "object",
      "description": "Additive-only block: multi-window returns/volatility proxy and normalized price motion (fractional returns).",
      "additionalProperties": false,
      "properties": {
        "ret_10s": { "type": ["number", "null"] },
        "ret_60s": { "type": ["number", "null"] },
        "ret_300s": { "type": ["number", "null"] },
        "vol_pct_10s": { "type": ["number", "null"], "minimum": 0 },
        "vol_pct_60s": { "type": ["number", "null"], "minimum": 0 },
        "vol_pct_300s": { "type": ["number", "null"], "minimum": 0 },
        "pm_norm_10s": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "pm_norm_60s": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "pm_norm_300s": { "type": ["number", "null"], "minimum": -1, "maximum": 1 }
      },
      "required": [
        "ret_10s",
        "ret_60s",
        "ret_300s",
        "vol_pct_10s",
        "vol_pct_60s",
        "vol_pct_300s",
        "pm_norm_10s",
        "pm_norm_60s",
        "pm_norm_300s"
      ]
    }
  },
  "required": ["ts", "symbol", "features"],
  "additionalProperties": false
}
