{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aurora.internal/schemas/position_policy_sidecar_mode_active_v1.json",
  "title": "EVT:POSITION_POLICY_SIDECAR_MODE_ACTIVE payload schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ts_ms",
    "trace_id",
    "symbol",
    "sidecar_version",
    "mode",
    "evaluation_mode",
    "event_type",
    "reason_codes",
    "position_snapshot",
    "feature_ref",
    "regime_ref",
    "freshness_snapshot"
  ],
  "properties": {
    "ts_ms": { "type": "integer", "minimum": 0 },
    "trace_id": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "sidecar_version": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["disable", "shadow", "enable"] },
    "evaluation_mode": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string", "const": "POSITION_POLICY_SIDECAR_MODE_ACTIVE" },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "position_snapshot": { "type": "object" },
    "feature_ref": { "type": "object" },
    "regime_ref": { "type": "object" },
    "freshness_snapshot": { "type": "object" },
    "sidecar_config_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "peak_giveback_close",
        "shadow_percent_notional_arm",
        "freshness",
        "source_config_path"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["disable", "shadow", "enable"] },
        "peak_giveback_close": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "edge_arm_usd", "giveback_trigger_pct"],
          "properties": {
            "enabled": { "type": "boolean" },
            "edge_arm_usd": { "type": "number" },
            "giveback_trigger_pct": { "type": "number" }
          }
        },
        "shadow_percent_notional_arm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "candidate_pcts", "candidate_unit"],
          "properties": {
            "enabled": { "type": "boolean" },
            "candidate_unit": { "type": "string", "const": "percent" },
            "candidate_pcts": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "portfolio_max_age_ms",
            "features_max_age_ms",
            "regime_max_age_ms",
            "order_state_max_age_ms"
          ],
          "properties": {
            "portfolio_max_age_ms": { "type": "integer", "minimum": 0 },
            "features_max_age_ms": { "type": "integer", "minimum": 0 },
            "regime_max_age_ms": { "type": "integer", "minimum": 0 },
            "order_state_max_age_ms": { "type": "integer", "minimum": 0 }
          }
        },
        "source_config_path": { "type": ["string", "null"] }
      }
    }
  }
}
