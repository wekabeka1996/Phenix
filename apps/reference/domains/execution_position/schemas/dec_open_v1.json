{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dec_open_v1.json",
  "title": "DEC:OPEN payload schema",
  "description": "Strict schema for DEC:OPEN. Fail-closed: execution must not assume defaults.",
  "type": "object",
  "additionalProperties": false,
  "required": ["symbol", "side", "qty", "order_type"],
  "properties": {
    "symbol": { "type": "string", "minLength": 1 },
    "side": { "type": "string", "enum": ["BUY", "SELL"] },
    "qty": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
    "order_type": { "type": "string", "enum": ["MARKET", "LIMIT"] },
    "price": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
        { "type": "null" }
      ]
    },
    "tif": {
      "anyOf": [
        { "type": "string", "enum": ["GTC", "GTX", "IOC", "FOK"] },
        { "type": "null" }
      ]
    },
    "valid_for_ms": {
      "anyOf": [
        { "type": "integer", "minimum": 1000 },
        { "type": "null" }
      ]
    },
    "stop_price": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
        { "type": "null" }
      ]
    },
    "target_price": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
        { "type": "null" }
      ]
    },
    "sl_pct": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
        { "type": "null" }
      ]
    },
    "idempotent_key": { "type": ["string", "null"] },
    "strategy": {
      "type": ["string", "null"],
      "description": "Canonical strategy attribution propagated from the accepted trade intent."
    },
    "decision_id": {
      "type": ["string", "null"],
      "description": "Decision identifier used for lifecycle attribution."
    },
    "intent_id": {
      "type": ["string", "null"],
      "description": "Intent identifier used for lifecycle attribution."
    },
    "regime_epoch_ref": {
      "type": ["string", "null"],
      "description": "Decision-making-owned stable regime epoch propagated additively to execution."
    },
    "regime": {
      "type": ["string", "null"],
      "description": "Decision-time structural regime propagated additively to execution."
    },
    "regime_confidence": {
      "type": ["number", "null"],
      "description": "Decision-time regime confidence propagated additively to execution."
    },
    "resolved_min_regime_confidence": {
      "type": ["number", "null"],
      "description": "Resolved minimum regime-confidence threshold propagated additively to execution."
    },
    "threshold_applied": {
      "type": ["boolean", "null"],
      "description": "Admission-threshold evaluation flag propagated additively to execution."
    },
    "threshold_verdict": {
      "type": ["string", "null"],
      "description": "Admission-threshold verdict propagated additively to execution."
    },
    "threshold_reason": {
      "type": ["string", "null"],
      "description": "Admission-threshold explanation propagated additively to execution."
    },
    "regime_confidence_gate_verdict": {
      "type": ["string", "null"],
      "description": "Canonical regime-confidence gate verdict propagated additively to execution."
    },
    "regime_provenance": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_kind": {
              "type": "string",
              "enum": ["detector_event", "detector_cache", "unknown"]
            },
            "detector_event": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "event_name": {"type": "string"},
                    "rid": {"type": ["string", "null"]},
                    "ts_ms": {"type": ["integer", "null"], "minimum": 0},
                    "last_update_ts_ms": {"type": ["integer", "null"], "minimum": 0},
                    "structural_regime_ref": {"type": ["string", "null"]},
                    "basis_tf_sec": {"type": ["integer", "null"], "minimum": 1},
                    "bar_close_ts_ms": {"type": ["integer", "null"], "minimum": 0},
                    "changed": {"type": ["boolean", "null"]},
                    "regime": {"type": ["string", "null"]},
                    "confidence": {"type": ["string", "null"]},
                    "stable_confidence": {"type": ["number", "string", "null"]},
                    "source_model": {"type": ["string", "null"]},
                    "pre_cutoff_source_model": {"type": ["string", "null"]},
                    "confidence_min": {"type": ["number", "string", "null"]},
                    "confidence_max": {"type": ["number", "string", "null"]},
                    "pre_cutoff_regime": {"type": ["string", "null"]},
                    "pre_cutoff_confidence": {"type": ["number", "string", "null"]},
                    "pre_cutoff_clamped_to_min": {"type": ["boolean", "null"]},
                    "pre_cutoff_clamped_to_max": {"type": ["boolean", "null"]},
                    "pre_cutoff_boundary_reason": {"type": ["string", "null"]},
                    "uncertain_cutoff": {"type": ["number", "string", "null"]},
                    "demoted_to_uncertain": {"type": ["boolean", "null"]},
                    "raw_regime": {"type": ["string", "null"]},
                    "raw_confidence": {"type": ["number", "string", "null"]},
                    "raw_boundary_reason": {"type": ["string", "null"]},
                    "hysteresis_bars": {"type": ["integer", "null"], "minimum": 1},
                    "hysteresis_confirm_count": {"type": ["integer", "null"], "minimum": 0},
                    "carried_previous_stable": {"type": ["boolean", "null"]},
                    "emitted_confidence_kind": {"type": ["string", "null"]},
                    "reason_summary": {"type": ["string", "null"]}
                  },
                  "required": [
                    "event_name",
                    "rid",
                    "ts_ms",
                    "last_update_ts_ms",
                    "structural_regime_ref",
                    "changed",
                    "regime",
                    "confidence",
                    "raw_regime",
                    "raw_confidence"
                  ]
                },
                { "type": "null" }
              ]
            },
            "cache_snapshot": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cache_write_ts_ms": {"type": ["integer", "null"], "minimum": 0},
                    "regime": {"type": ["string", "null"]},
                    "confidence": {"type": ["number", "null"]}
                  },
                  "required": [
                    "cache_write_ts_ms",
                    "regime",
                    "confidence"
                  ]
                },
                { "type": "null" }
              ]
            }
          },
          "required": ["source_kind", "detector_event", "cache_snapshot"]
        },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "order_type": { "const": "LIMIT" } },
        "required": ["order_type"]
      },
      "then": {
        "required": ["price", "tif", "valid_for_ms"],
        "properties": {
          "price": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
          "tif": { "type": "string", "enum": ["GTC", "GTX", "IOC", "FOK"] },
          "valid_for_ms": { "type": "integer", "minimum": 1000 }
        }
      }
    },
    {
      "if": {
        "properties": { "order_type": { "const": "MARKET" } },
        "required": ["order_type"]
      },
      "then": {
        "properties": {
          "tif": { "type": "null" }
        }
      }
    }
  ]
}
