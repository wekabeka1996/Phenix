{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aurora.internal/schemas/position_policy_sidecar_fee_aware_shadow_arm_state_v1.json",
  "title": "EVT:POSITION_POLICY_SIDECAR_FEE_AWARE_SHADOW_ARM_STATE payload schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ts_ms",
    "trace_id",
    "symbol",
    "sidecar_version",
    "event_type",
    "reason_codes",
    "shadow_only",
    "authority_applied",
    "no_effect",
    "trigger_event",
    "transitions",
    "candidate_state",
    "position_snapshot"
  ],
  "properties": {
    "ts_ms": { "type": "integer", "minimum": 0 },
    "trace_id": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "sidecar_version": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string", "const": "POSITION_POLICY_SIDECAR_FEE_AWARE_SHADOW_ARM_STATE" },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "shadow_only": { "type": "boolean", "const": true },
    "authority_applied": { "type": "boolean", "const": false },
    "no_effect": { "type": "boolean", "const": true },
    "trigger_event": { "type": "string" },
    "transitions": { "type": "array", "items": { "type": "string" } },
    "candidate_state": { "type": "object" },
    "position_snapshot": { "type": "object" }
  }
}
