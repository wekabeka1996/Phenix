{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aurora.internal/schemas/position_policy_sidecar_scores_v1.json",
  "title": "EVT:POSITION_POLICY_SIDECAR_SCORES payload schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ts_ms",
    "trace_id",
    "symbol",
    "sidecar_version",
    "mode",
    "evaluation_mode",
    "event_type",
    "reason_codes",
    "position_snapshot",
    "feature_ref",
    "regime_ref",
    "freshness_snapshot",
    "score_snapshot"
  ],
  "properties": {
    "ts_ms": { "type": "integer", "minimum": 0 },
    "trace_id": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "sidecar_version": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["disable", "shadow", "enable"] },
    "evaluation_mode": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string", "const": "POSITION_POLICY_SIDECAR_SCORES" },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "position_snapshot": { "type": "object" },
    "feature_ref": { "type": "object" },
    "regime_ref": { "type": "object" },
    "freshness_snapshot": { "type": "object" },
    "score_snapshot": { "type": "object" },
    "peak_giveback_snapshot": {
      "$ref": "https://aurora.internal/schemas/common/peak_giveback_snapshot_v1.json"
    }
  }
}
