{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aurora.internal/schemas/cmd_position_policy_sidecar_close_request_v1.json",
  "title": "CMD:POSITION_POLICY_SIDECAR_CLOSE_REQUEST payload schema",
  "description": "Internal EP-owned soft-close request emitted by Position Policy Sidecar under the admitted Phase-2 narrow action contract.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ts_ms",
    "request_id",
    "trace_id",
    "symbol",
    "sidecar_version",
    "mode",
    "evaluation_mode",
    "event_type",
    "source_event_type",
    "requested_action",
    "target_mode",
    "policy_source",
    "action_package_version",
    "allowed_action_scope",
    "reason_codes",
    "score_snapshot",
    "position_snapshot",
    "feature_ref",
    "regime_ref",
    "freshness_snapshot",
    "fill_correlation",
    "portfolio_correlation"
  ],
  "properties": {
    "ts_ms": { "type": "integer", "minimum": 0 },
    "request_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "minLength": 1 },
    "sidecar_version": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["disable", "shadow", "enable"] },
    "evaluation_mode": { "type": "string", "minLength": 1 },
    "event_type": { "type": "string", "const": "POSITION_POLICY_SIDECAR_CLOSE_REQUESTED" },
    "source_event_type": { "type": "string", "const": "POSITION_POLICY_SIDECAR_RECOMMENDED" },
    "requested_action": { "type": "string", "const": "SOFT_CLOSE" },
    "requested_qty": { "type": ["string", "null"] },
    "target_mode": { "type": "string", "const": "symbol_current_net_only" },
    "policy_source": { "type": "string", "const": "position_policy_sidecar" },
    "action_package_version": { "type": "string", "minLength": 1 },
    "allowed_action_scope": { "type": "object" },
    "reason_codes": { "type": "array", "items": { "type": "string" } },
    "score_snapshot": { "type": "object" },
    "position_snapshot": { "type": "object" },
    "feature_ref": { "type": "object" },
    "regime_ref": { "type": "object" },
    "freshness_snapshot": { "type": "object" },
    "fill_correlation": { "type": "object" },
    "portfolio_correlation": { "type": "object" }
  }
}
