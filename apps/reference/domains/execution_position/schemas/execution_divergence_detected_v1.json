{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "execution_divergence_detected_v1.json",
  "title": "EVT:EXECUTION_DIVERGENCE_DETECTED payload schema",
  "description": "Structured split-brain divergence telemetry for execution_position.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ts_ms",
    "symbol",
    "local_manage_state",
    "portfolio_state",
    "divergence_type",
    "why"
  ],
  "properties": {
    "ts_ms": { "type": "integer", "minimum": 0 },
    "symbol": { "type": "string", "minLength": 1 },
    "current_rid": { "type": ["string", "null"] },
    "tracked_rid": { "type": ["string", "null"] },
    "lifecycle_id": { "type": ["string", "null"] },
    "local_manage_state": { "type": "string", "minLength": 1 },
    "portfolio_state": { "type": "string", "minLength": 1 },
    "divergence_type": { "type": "string", "minLength": 1 },
    "why": { "type": "string", "maxLength": 80 }
  }
}
