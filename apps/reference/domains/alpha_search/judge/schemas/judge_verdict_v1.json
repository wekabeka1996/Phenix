{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://aurora.internal/schemas/alpha_search/judge/judge_verdict_v1.json",
    "title": "JudgeVerdict v1",
    "description": "Final judge policy verdict for a specific evaluation.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "verdict_id",
        "envelope_id",
        "chamber_id",
        "symbol",
        "tf_sec",
        "ts_ms",
        "verdict_scope",
        "confidence",
        "reasoning",
        "dissent_noted",
        "authority_mode",
        "applied",
        "strategy_id",
        "schema_version"
    ],
    "properties": {
        "verdict_id": {
            "type": "string",
            "minLength": 1
        },
        "envelope_id": {
            "type": "string",
            "minLength": 1
        },
        "chamber_id": {
            "type": "string",
            "minLength": 1
        },
        "symbol": {
            "type": "string",
            "minLength": 1
        },
        "tf_sec": {
            "type": "integer",
            "exclusiveMinimum": 0
        },
        "ts_ms": {
            "type": "integer",
            "exclusiveMinimum": 0
        },
        "verdict_scope": {
            "type": "string",
            "enum": ["ENTRY", "LIFECYCLE"]
        },
        "entry_verdict": {
            "type": ["string", "null"],
            "enum": ["OPEN_LONG", "OPEN_SHORT", "NO_ENTRY", "SUPPRESS", "UNKNOWN", null]
        },
        "lifecycle_verdict": {
            "type": ["string", "null"],
            "enum": ["HOLD", "PROTECT", "EXIT", "SUPPRESS", "UNKNOWN", null]
        },
        "suppression_reason": {
            "type": ["string", "null"]
        },
        "suppression_code": {
            "type": ["string", "null"]
        },
        "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
        },
        "reasoning": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "minItems": 1
        },
        "dissent_noted": {
            "type": "boolean"
        },
        "authority_mode": {
            "type": "string",
            "enum": ["off", "shadow", "hybrid_advisory", "guarded_entry_authority", "guarded_lifecycle_authority"]
        },
        "applied": {
            "type": "boolean"
        },
        "strategy_id": {
            "type": "string",
            "minLength": 1
        },
        "schema_version": {
            "type": "string",
            "enum": ["1"]
        }
    }
}
