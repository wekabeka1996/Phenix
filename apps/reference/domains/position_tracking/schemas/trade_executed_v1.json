{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "trade_executed_v1.json",
  "title": "Trade Executed Event",
  "description": "Schema for EVT:TRADE_EXECUTED event payload describing a single executed trade",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "description": "Trading instrument symbol (e.g., 'BTCUSDT')"
    },
    "side": {
      "type": "string",
      "enum": ["buy", "sell"],
      "description": "Trade direction: 'buy' for long positions, 'sell' for short positions"
    },
    "price": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "Execution price per unit (string-encoded Decimal for precision)"
    },
    "quantity": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "Executed quantity (positive for buy, negative for sell) (string-encoded Decimal for precision)"
    },
    "ts": {
      "type": "integer",
      "description": "Timestamp of trade execution in milliseconds"
    },
    "fees": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "Trading fees paid for this trade (optional, defaults to 0) (string-encoded Decimal for precision)",
      "default": "0.0"
    },
    "rid": {
      "type": "string"
    },
    "idempotent_key": {
      "type": "string"
    },
    "clientOrderId": {
      "type": "string"
    },
    "client_order_id": {
      "type": "string"
    },
    "exchangeOrderId": {
      "type": "string"
    },
    "orderId": {
      "type": "string"
    },
    "tradeId": {
      "type": "string"
    },
    "trade_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "order_type": {
      "type": "string"
    },
    "time_in_force": {
      "type": "string"
    },
    "qty": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "ts_ms": {
      "type": "integer"
    },
    "last_fill_qty": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "cumulative_qty": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "commission": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "commissionAsset": {
      "type": "string"
    },
    "realizedPnl": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "close_reason": {
      "type": "string"
    },
    "bracket_role": {
      "type": "string"
    },
    "tracked_bracket_order_id": {
      "type": "string"
    },
    "parent_entry_order_id": {
      "type": "string"
    },
    "terminal_correlation_source": {
      "type": "string"
    },
    "correlation_recovered": {
      "type": "boolean"
    },
    "venue": {
      "type": "string",
      "description": "Trading venue/exchange where the trade was executed"
    }
  },
  "required": ["symbol", "side", "price", "quantity", "ts", "venue"],
  "additionalProperties": false
}
