{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aurora.internal/schemas/decision_making/judge_bridge_decision_v1.json",
  "title": "JudgeBridgeDecision v1",
  "description": "Pure DecisionMaking Judge bridge evaluation output. It is not an order or command.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bridge_decision_id",
    "source_verdict_id",
    "decision_id",
    "symbol",
    "runtime_mode",
    "authority_mode",
    "bridge_action",
    "applied",
    "no_effect",
    "reason_codes",
    "confidence",
    "confidence_band_label",
    "hard_gates_passed",
    "hard_gate_blocking_reasons",
    "unknown_policy_applied",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "bridge_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "source_verdict_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": ["string", "null"]
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "runtime_mode": {
      "type": "string",
      "minLength": 1
    },
    "authority_mode": {
      "type": "string",
      "enum": ["shadow", "advisory", "hybrid_gated", "live_gated"]
    },
    "bridge_action": {
      "type": "string",
      "enum": ["record_only", "allow", "suppress", "skip", "blocked"]
    },
    "applied": {
      "type": "boolean"
    },
    "no_effect": {
      "type": "boolean"
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "confidence_band_label": {
      "type": ["string", "null"]
    },
    "hard_gates_passed": {
      "type": "boolean"
    },
    "hard_gate_blocking_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknown_policy_applied": {
      "type": "boolean"
    },
    "source_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_id", "rid", "cycle_key"],
      "properties": {
        "envelope_id": {
          "type": "string",
          "minLength": 1
        },
        "rid": {
          "type": ["string", "null"]
        },
        "cycle_key": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
