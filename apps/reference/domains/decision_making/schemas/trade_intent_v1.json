{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "trade_intent_v1.json",
  "title": "Trade Intent Proposed Event",
  "description": "Schema for EVT:TRADE_INTENT_PROPOSED event payload describing a proposed trade intent. EP-01.2-INT: Added stop_price/target_price for ATR-based SL/TP.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "instrument": {
      "type": "string",
      "description": "Trading instrument symbol (e.g., 'BTCUSDT', 'ETHUSDT')"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell",
        "BUY",
        "SELL"
      ],
      "description": "Trade direction: 'buy'/'BUY' for long positions, 'sell'/'SELL' for short positions"
    },
    "p": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "description": "Probability of success for this trade intent (string-encoded Decimal for precision)"
    },
    "payoff_ratio_r": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "description": "Payoff ratio (reward/risk ratio) (string-encoded Decimal for precision)"
    },
    "tca_budget": {
      "type": "object",
      "description": "Transaction Cost Analysis budget constraints",
      "additionalProperties": false,
      "properties": {
        "max_slippage_bps": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Maximum acceptable slippage in basis points"
        },
        "max_latency_ms": {
          "type": "integer",
          "description": "Maximum acceptable latency in milliseconds"
        },
        "maker_preference": {
          "type": "string",
          "description": "Preference for maker vs taker orders (e.g., 'allow', 'prefer', 'require')"
        }
      },
      "required": [
        "max_slippage_bps",
        "max_latency_ms",
        "maker_preference"
      ]
    },
    "risk_budget": {
      "type": "object",
      "description": "Risk budget constraints",
      "additionalProperties": false,
      "properties": {
        "trade_cvar95_max_bps": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Maximum CVaR95 for this trade in basis points"
        },
        "session_cvar95_max_bps": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Maximum CVaR95 for the entire session in basis points"
        }
      },
      "required": [
        "trade_cvar95_max_bps",
        "session_cvar95_max_bps"
      ]
    },
    "size": {
      "type": "object",
      "description": "Position sizing parameters",
      "additionalProperties": false,
      "properties": {
        "kelly_fraction": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Kelly fraction used for sizing (string-encoded Decimal)"
        },
        "notional_cap_usd": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Notional cap in USD (string-encoded Decimal)"
        }
      },
      "required": [
        "kelly_fraction",
        "notional_cap_usd"
      ]
    },
    "order": {
      "type": "object",
      "description": "Order execution parameters",
      "additionalProperties": false,
      "properties": {
        "price_ref": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Reference price for the order (string-encoded Decimal)"
        },
        "qty": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Order quantity (string-encoded Decimal)"
        },
        "price": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Order price (string-encoded Decimal)"
        },
        "reduce_only": {
          "type": "boolean",
          "description": "Whether this order is reduce-only (true) or can open new positions (false)"
        },
        "order_type": {
          "type": "string",
          "enum": [
            "LIMIT",
            "MARKET"
          ],
          "description": "ORDER-POLICY-01: Order type. REQUIRED. No silent defaults."
        },
        "tif": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "GTC",
                "GTX",
                "IOC",
                "FOK"
              ],
              "description": "Time in force: GTC (good-till-cancel), GTX (post-only/maker-only), IOC, FOK"
            },
            {
              "type": "null"
            }
          ],
          "description": "EP-01.4-INT: Time in force for LIMIT orders. GTX = post-only (maker-only). Null only allowed for MARKET orders."
        }
      },
      "required": [
        "price_ref",
        "qty",
        "reduce_only",
        "order_type"
      ]
    },
    "stop_price": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ],
      "description": "EP-01.2-INT: Stop-loss price (string-encoded Decimal). Null if not computed (e.g., ATR not ready)."
    },
    "target_price": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ],
      "description": "EP-01.2-INT: Take-profit price (string-encoded Decimal). Null if not computed."
    },
    "entry_plan": {
      "anyOf": [
        {
          "type": "object",
          "description": "EP-01.2-INT: EntryPlan computation trace for debugging/audit",
          "additionalProperties": false,
          "properties": {
            "ref_price": {
              "type": "string",
              "description": "Reference price used for computation"
            },
            "atr": {
              "type": "string",
              "description": "ATR value used"
            },
            "obi": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "OBI value used (null if missing)"
            },
            "obi_multiplier": {
              "type": "number",
              "description": "Actual OBI multiplier applied (after clamp)"
            },
            "obi_policy_applied": {
              "type": "boolean",
              "description": "True if neutral policy was applied"
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "EP-01.2-INT: EntryPlan computation trace. Null if EntryPlan not used."
    },
    "valid_for_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1000,
          "description": "TTL in milliseconds (must be >= 1000)"
        },
        {
          "type": "null"
        }
      ],
      "description": "EP-01.3-INT: Validity period for pending LIMIT entry order. Calculated from ttl_by_tf_sec[tf_sec]*1000. Null means use global watchdog fill_ttl_ms."
    },
    "why": {
      "type": "array",
      "description": "Explainability chain describing the decision logic",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "dto_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "DTO version in semver format (e.g., '1.0.0')"
    },
    "schema_ref": {
      "type": "string",
      "description": "URI reference to the schema definition"
    },
    "rid": {
      "type": "string",
      "description": "Request ID for correlation"
    },
    "strategy": {
      "type": "string",
      "description": "Strategy ID that produced this intent"
    },
    "idempotent_key": {
      "type": "string",
      "description": "Idempotency key to prevent duplicate processing"
    },
    "regime": {
      "type": [
        "string",
        "null"
      ],
      "description": "Detected regime at decision time"
    },
    "regime_confidence": {
      "type": [
        "number",
        "null"
      ],
      "description": "Confidence of the detected regime"
    },
    "risk_context": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Context around risk gating"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "order": {
            "properties": {
              "order_type": {
                "const": "LIMIT"
              }
            },
            "required": [
              "order_type"
            ]
          }
        },
        "required": [
          "order"
        ]
      },
      "then": {
        "required": [
          "valid_for_ms"
        ],
        "properties": {
          "valid_for_ms": {
            "type": "integer",
            "minimum": 1000
          },
          "order": {
            "required": [
              "price",
              "tif"
            ],
            "properties": {
              "price": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?$"
              },
              "tif": {
                "type": "string",
                "enum": [
                  "GTC",
                  "GTX",
                  "IOC",
                  "FOK"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "order": {
            "properties": {
              "order_type": {
                "const": "MARKET"
              }
            },
            "required": [
              "order_type"
            ]
          }
        },
        "required": [
          "order"
        ]
      },
      "then": {
        "properties": {
          "order": {
            "properties": {
              "tif": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ],
  "required": [
    "instrument",
    "side",
    "p",
    "payoff_ratio_r",
    "tca_budget",
    "risk_budget",
    "size",
    "order",
    "why",
    "dto_version",
    "schema_ref"
  ]
}