{
    "$id": "https://phenix.local/schemas/str_decision_blocked_v1.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Strategy Decision Blocked Event",
    "description": "Schema for EVT:STRATEGY_DECISION_BLOCKED events (emitted by decision-making).",
    "type": "object",
    "properties": {
        "symbol": {
            "type": "string",
            "description": "The symbol the block relates to (e.g. 'BTCUSDT')"
        },
        "reason_code": {
            "type": "string"
        },
        "reason": {
            "type": "string",
            "description": "The description block for why the order/intent was blocked."
        },
        "stage": {
            "type": "string",
            "enum": ["STRATEGY"],
            "description": "Truth-class stage for strategy-side blocked decisions."
        },
        "context": {
            "type": "string"
        },
        "why": {
            "type": "string",
            "description": "Compact human explanation for forensic reconstruction."
        },
        "ts_ms": {
            "type": "integer"
        },
        "rid": {
            "type": "string"
        },
        "span_id": {
            "type": "string"
        },
        "tf_sec": {
            "type": "integer"
        },
        "bar_close_ts": {
            "type": "integer"
        },
        "why_chain": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "details": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
                "anti_peak_observability": {
                    "type": ["object", "null"],
                    "additionalProperties": true,
                    "properties": {
                        "enabled": {"type": ["boolean", "null"]},
                        "gate_disabled": {"type": ["boolean", "null"]},
                        "motion_classification": {"type": ["string", "null"]},
                        "missing_inputs": {
                            "type": ["object", "null"],
                            "additionalProperties": {"type": ["string", "null"]}
                        },
                        "active_config": {"type": ["object", "null"], "additionalProperties": true},
                        "disabled_config_snapshot": {"type": ["object", "null"], "additionalProperties": true},
                        "anti_fomo_sigma": {"type": ["number", "null"]},
                        "anti_flat_sigma": {"type": ["number", "null"]},
                        "window_sec": {"type": ["integer", "null"]},
                        "anti_fomo_sigma_value_source": {"type": ["string", "null"]},
                        "anti_flat_sigma_value_source": {"type": ["string", "null"]},
                        "window_sec_value_source": {"type": ["string", "null"]},
                        "motion_norm_sigma": {"type": ["number", "null"]},
                        "score_before_shields": {"type": ["number", "null"]},
                        "score_after_shields": {"type": ["number", "null"]},
                        "final_score": {"type": ["number", "null"]},
                        "signal_threshold": {"type": ["number", "null"]},
                        "danger_zone_applied": {"type": ["boolean", "null"]},
                        "context_shield_applied": {"type": ["boolean", "null"]},
                        "attenuated_below_threshold": {"type": ["boolean", "null"]},
                        "consumed_by_gate": {"type": ["boolean", "null"]},
                        "source": {"type": ["string", "null"]},
                        "ready": {"type": ["boolean", "null"]},
                        "reason": {"type": ["string", "null"]}
                    }
                }
            }
        }
    },
    "required": [
        "symbol",
        "reason_code",
        "reason",
        "stage",
        "context",
        "why",
        "ts_ms",
        "why_chain"
    ]
}
