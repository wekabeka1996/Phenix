{
  "$id": "https://phenix.internal/schemas/gate_chain_trace_v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gate Chain Trace",
  "description": "Observability trace for a single StrategyGateway GateChain evaluation run.",
  "type": "object",
  "required": [
    "symbol",
    "strategy_id",
    "ts_ms",
    "gates",
    "final_outcome",
    "total_elapsed_ms"
  ],
  "properties": {
    "symbol": {
      "type": "string",
      "description": "The symbol being evaluated"
    },
    "strategy_id": {
      "type": "string",
      "description": "The strategy ID"
    },
    "rid": {
      "type": "string",
      "description": "The request ID"
    },
    "ts_ms": {
      "type": "integer",
      "description": "Timestamp of the signal evaluation in milliseconds"
    },
    "final_outcome": {
      "type": "string",
      "enum": ["PASS", "REJECT", "DEFER", "BLOCK", "ERROR"],
      "description": "The final aggregate outcome of the gate chain"
    },
    "total_elapsed_ms": {
      "type": "number",
      "description": "Total time taken by the gate chain in milliseconds"
    },
    "gates": {
      "type": "array",
      "description": "Ordered list of gate evaluations",
      "items": {
        "type": "object",
        "required": ["gate_name", "outcome", "elapsed_ms"],
        "properties": {
          "gate_name": {
            "type": "string",
            "description": "Name of the gate"
          },
          "outcome": {
            "type": "string",
            "description": "Outcome of this specific gate"
          },
          "reason_code": {
            "type": "string",
            "description": "Optional reason code if the gate did not pass"
          },
          "elapsed_ms": {
            "type": "number",
            "description": "Time taken by this gate in milliseconds"
          }
        }
      }
    }
  }
}
