{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "trade_intent_v1.json",
  "title": "Trade Intent Proposed Event",
  "description": "Schema for EVT:TRADE_INTENT_PROPOSED event payload describing a proposed trade intent. EP-01.2-INT: Added stop_price/target_price for ATR-based SL/TP.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "instrument": {
      "type": "string",
      "description": "Trading instrument symbol (e.g., 'BTCUSDT', 'ETHUSDT')"
    },
    "side": {
      "type": "string",
      "enum": [
        "buy",
        "sell",
        "BUY",
        "SELL"
      ],
      "description": "Trade direction: 'buy'/'BUY' for long positions, 'sell'/'SELL' for short positions"
    },
    "p": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "description": "Probability of success for this trade intent (string-encoded Decimal for precision)"
    },
    "payoff_ratio_r": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "description": "Payoff ratio (reward/risk ratio) (string-encoded Decimal for precision)"
    },
    "tca_budget": {
      "type": "object",
      "description": "Transaction Cost Analysis budget constraints",
      "additionalProperties": false,
      "properties": {
        "max_slippage_bps": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Maximum acceptable slippage in basis points"
        },
        "max_latency_ms": {
          "type": "integer",
          "description": "Maximum acceptable latency in milliseconds"
        },
        "maker_preference": {
          "type": "string",
          "description": "Preference for maker vs taker orders (e.g., 'allow', 'prefer', 'require')"
        }
      },
      "required": [
        "max_slippage_bps",
        "max_latency_ms",
        "maker_preference"
      ]
    },
    "risk_budget": {
      "type": "object",
      "description": "Risk budget constraints",
      "additionalProperties": false,
      "properties": {
        "trade_cvar95_max_bps": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Maximum CVaR95 for this trade in basis points"
        },
        "session_cvar95_max_bps": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Maximum CVaR95 for the entire session in basis points"
        }
      },
      "required": [
        "trade_cvar95_max_bps",
        "session_cvar95_max_bps"
      ]
    },
    "size": {
      "type": "object",
      "description": "Position sizing parameters",
      "additionalProperties": false,
      "properties": {
        "kelly_fraction": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Kelly fraction used for sizing (string-encoded Decimal)"
        },
        "notional_cap_usd": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Notional cap in USD (string-encoded Decimal)"
        }
      },
      "required": [
        "kelly_fraction",
        "notional_cap_usd"
      ]
    },
    "order": {
      "type": "object",
      "description": "Order execution parameters",
      "additionalProperties": false,
      "properties": {
        "price_ref": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Reference price for the order (string-encoded Decimal)"
        },
        "qty": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Order quantity (string-encoded Decimal)"
        },
        "price": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Order price (string-encoded Decimal)"
        },
        "reduce_only": {
          "type": "boolean",
          "description": "Whether this order is reduce-only (true) or can open new positions (false)"
        },
        "order_type": {
          "type": "string",
          "enum": [
            "LIMIT",
            "MARKET"
          ],
          "description": "ORDER-POLICY-01: Order type. REQUIRED. No silent defaults."
        },
        "tif": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "GTC",
                "GTX",
                "IOC",
                "FOK"
              ],
              "description": "Time in force: GTC (good-till-cancel), GTX (post-only/maker-only), IOC, FOK"
            },
            {
              "type": "null"
            }
          ],
          "description": "EP-01.4-INT: Time in force for LIMIT orders. GTX = post-only (maker-only). Null only allowed for MARKET orders."
        }
      },
      "required": [
        "price_ref",
        "qty",
        "reduce_only",
        "order_type"
      ]
    },
    "stop_price": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ],
      "description": "EP-01.2-INT: Stop-loss price (string-encoded Decimal). Null if not computed (e.g., ATR not ready)."
    },
    "target_price": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ],
      "description": "EP-01.2-INT: Take-profit price (string-encoded Decimal). Null if not computed."
    },
    "entry_plan": {
      "anyOf": [
        {
          "type": "object",
          "description": "EP-01.2-INT: EntryPlan computation trace for debugging/audit",
          "additionalProperties": false,
          "properties": {
            "ref_price": {
              "type": "string",
              "description": "Reference price used for computation"
            },
            "atr": {
              "type": "string",
              "description": "ATR value used"
            },
            "obi": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "OBI value used (null if missing)"
            },
            "obi_multiplier": {
              "type": "number",
              "description": "Actual OBI multiplier applied (after clamp)"
            },
            "obi_policy_applied": {
              "type": "boolean",
              "description": "True if neutral policy was applied"
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "EP-01.2-INT: EntryPlan computation trace. Null if EntryPlan not used."
    },
    "tpsl_owner_ctx": {
      "anyOf": [
        {
          "type": "object",
          "description": "Additive Aurora TP/SL owner-selection truth. Makes intended owner, final owner, and owner-loss reason explicit without changing TP/SL math.",
          "additionalProperties": false,
          "properties": {
            "intended_owner": {
              "type": "string",
              "enum": [
                "regime_tpsl",
                "entry_plan"
              ]
            },
            "final_owner": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "regime_tpsl",
                    "entry_plan"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "owner_loss_reason": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "REGIME_TPSL_DISABLED_OR_MISSING",
                    "REGIME_TPSL_CONFIG_ERROR",
                    "REGIME_TPSL_ATR_UNAVAILABLE",
                    "REGIME_TPSL_INVALID_INPUT",
                    "REGIME_TPSL_UNSUPPORTED_MODE",
                    "TPSL_GUARDRAIL_SL_WRONG_SIDE",
                    "TPSL_GUARDRAIL_TP_WRONG_SIDE",
                    "TPSL_GUARDRAIL_SL_MIN_DIST_BPS",
                    "TPSL_GUARDRAIL_TP_MIN_DIST_BPS"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "intended_owner",
            "final_owner",
            "owner_loss_reason"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_for_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1000,
          "description": "TTL in milliseconds (must be >= 1000)"
        },
        {
          "type": "null"
        }
      ],
      "description": "EP-01.3-INT: Validity period for pending LIMIT entry order. Calculated from ttl_by_tf_sec[tf_sec]*1000. Null means use global watchdog fill_ttl_ms."
    },
    "why": {
      "type": "array",
      "description": "Explainability chain describing the decision logic",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "dto_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "DTO version in semver format (e.g., '1.0.0')"
    },
    "schema_ref": {
      "type": "string",
      "description": "URI reference to the schema definition"
    },
    "rid": {
      "type": "string",
      "description": "Request ID for correlation"
    },
    "strategy": {
      "type": "string",
      "description": "Strategy ID that produced this intent"
    },
    "idempotent_key": {
      "type": "string",
      "description": "Idempotency key to prevent duplicate processing"
    },
    "regime": {
      "type": [
        "string",
        "null"
      ],
      "description": "Detected regime at decision time"
    },
    "regime_epoch_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "Decision-making-owned stable regime epoch propagated additively to execution."
    },
    "regime_confidence": {
      "type": [
        "number",
        "null"
      ],
      "description": "Confidence of the detected regime"
    },
    "regime_provenance": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_kind": {
              "type": "string",
              "enum": [
                "detector_event",
                "detector_cache",
                "unknown"
              ]
            },
            "detector_event": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "event_name": {"type": "string"},
                    "rid": {"type": ["string", "null"]},
                    "ts_ms": {"type": ["integer", "null"], "minimum": 0},
                    "last_update_ts_ms": {"type": ["integer", "null"], "minimum": 0},
                    "structural_regime_ref": {"type": ["string", "null"]},
                    "basis_tf_sec": {"type": ["integer", "null"], "minimum": 1},
                    "bar_close_ts_ms": {"type": ["integer", "null"], "minimum": 0},
                    "changed": {"type": ["boolean", "null"]},
                    "regime": {"type": ["string", "null"]},
                    "confidence": {"type": ["string", "null"]},
                    "stable_confidence": {
                      "type": ["number", "string", "null"]
                    },
                    "source_model": {"type": ["string", "null"]},
                    "pre_cutoff_source_model": {"type": ["string", "null"]},
                    "confidence_min": {
                      "type": ["number", "string", "null"]
                    },
                    "confidence_max": {
                      "type": ["number", "string", "null"]
                    },
                    "pre_cutoff_regime": {"type": ["string", "null"]},
                    "pre_cutoff_confidence": {
                      "type": ["number", "string", "null"]
                    },
                    "pre_cutoff_clamped_to_min": {"type": ["boolean", "null"]},
                    "pre_cutoff_clamped_to_max": {"type": ["boolean", "null"]},
                    "pre_cutoff_boundary_reason": {"type": ["string", "null"]},
                    "uncertain_cutoff": {
                      "type": ["number", "string", "null"]
                    },
                    "demoted_to_uncertain": {"type": ["boolean", "null"]},
                    "raw_regime": {"type": ["string", "null"]},
                    "raw_confidence": {
                      "type": ["number", "string", "null"]
                    },
                    "raw_boundary_reason": {"type": ["string", "null"]},
                    "hysteresis_bars": {"type": ["integer", "null"], "minimum": 1},
                    "hysteresis_confirm_count": {"type": ["integer", "null"], "minimum": 0},
                    "carried_previous_stable": {"type": ["boolean", "null"]},
                    "emitted_confidence_kind": {"type": ["string", "null"]},
                    "reason_summary": {"type": ["string", "null"]}
                  },
                  "required": [
                    "event_name",
                    "rid",
                    "ts_ms",
                    "last_update_ts_ms",
                    "structural_regime_ref",
                    "changed",
                    "regime",
                    "confidence",
                    "raw_regime",
                    "raw_confidence"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "cache_snapshot": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cache_write_ts_ms": {"type": ["integer", "null"], "minimum": 0},
                    "regime": {"type": ["string", "null"]},
                    "confidence": {"type": ["number", "null"]}
                  },
                  "required": [
                    "cache_write_ts_ms",
                    "regime",
                    "confidence"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "source_kind",
            "detector_event",
            "cache_snapshot"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Additive provenance chain for the regime snapshot used during intent build."
    },
    "risk_context": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Context around risk gating"
    },
    "trace": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "$comment": "Canonical optional execution-boundary field. Producer/schema co-evolution tests must keep this additive contract aligned.",
      "description": "Strategy audit/debug trace produced by the objective engine or md_amr tracer. Optional top-level field for execution-boundary diagnostics; present only when strategy_trace is non-null in IntentBuilder."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "order": {
            "properties": {
              "order_type": {
                "const": "LIMIT"
              }
            },
            "required": [
              "order_type"
            ]
          }
        },
        "required": [
          "order"
        ]
      },
      "then": {
        "required": [
          "valid_for_ms"
        ],
        "properties": {
          "valid_for_ms": {
            "type": "integer",
            "minimum": 1000
          },
          "order": {
            "required": [
              "price",
              "tif"
            ],
            "properties": {
              "price": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?$"
              },
              "tif": {
                "type": "string",
                "enum": [
                  "GTC",
                  "GTX",
                  "IOC",
                  "FOK"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "order": {
            "properties": {
              "order_type": {
                "const": "MARKET"
              }
            },
            "required": [
              "order_type"
            ]
          }
        },
        "required": [
          "order"
        ]
      },
      "then": {
        "properties": {
          "order": {
            "properties": {
              "tif": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ],
  "required": [
    "instrument",
    "side",
    "p",
    "payoff_ratio_r",
    "tca_budget",
    "risk_budget",
    "size",
    "order",
    "why",
    "dto_version",
    "schema_ref"
  ]
}
