{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order_logger_v1.json",
  "title": "Order Logger V1 Schema",
  "description": "JSON Schema for order logging entries",
  "type": "object",
  "properties": {
    "rid": {
      "type": "string",
      "description": "Request ID for tracing"
    },
    "timestamp": {
      "type": "integer",
      "description": "Timestamp in milliseconds",
      "minimum": 0
    },
    "event_type": {
      "type": "string",
      "enum": [
        "BOOT",
        "STRATEGY_REGISTRY_SNAPSHOT",
        "ORDER_INTENT",
        "ORDER_PLACED",
        "ORDER_FILLED",
        "ORDER_CANCELLED",
        "ORDER_CANCELLATION_FAILED",
        "ORDER_TIMEOUT",
        "ORDER_REJECTED",
        "DECISION_INTENT_REJECTED",
        "ORDER_STATE_CHANGED",
        "POSITION_CLOSED",
        "QTY_NORMALIZE_REJECTED"
      ],
      "description": "Type of order event"
    },
    "order_id": {
      "type": "string",
      "description": "Exchange order ID"
    },
    "client_order_id": {
      "type": "string",
      "description": "Client order ID"
    },
    "symbol": {
      "type": "string",
      "description": "Trading symbol"
    },
    "side": {
      "type": "string",
      "enum": ["BUY", "SELL", "NONE"],
      "description": "Order side"
    },
    "quantity": {
      "type": "number",
      "description": "Order quantity",
      "minimum": 0
    },
    "price": {
      "type": "number",
      "description": "Order price",
      "minimum": 0
    },
    "nrr_code": {
      "type": "string",
      "pattern": "^NRR-[0-9]{3}$",
      "description": "NRR error code"
    },
    "origin_class": {
      "type": "string",
      "enum": [
        "execution_adapter",
        "execution_internal",
        "exchange_websocket",
        "decision_alias",
        "unknown"
      ],
      "description": "Canonical provenance for reject-like rows"
    },
    "why": {
      "type": "string",
      "maxLength": 80,
      "description": "Reason for the event"
    },
    "source_fsm": {
      "type": "string",
      "description": "FSM that generated the event"
    },
    "reservation_id": {
      "type": "string",
      "description": "Exposure reservation ID"
    },
    "adapter_response": {
      "type": "object",
      "description": "Raw adapter response"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata"
    },
    "close_reason": {
      "type": "string",
      "description": "Why the order/position closed: SL_HIT, TP_HIT, ENTRY_FILLED, MARKET_FILLED, BACKTEST_END, CANCEL_STALE_REGIME, etc."
    },
    "order_kind": {
      "type": "string",
      "description": "Order role: ENTRY, SL, TP, CLOSE"
    },
    "order_type": {
      "type": "string",
      "description": "Exchange order type: LIMIT, MARKET, STOP_MARKET, TAKE_PROFIT_MARKET"
    },
    "reason": {
      "type": "string",
      "description": "Cancellation or rejection reason string"
    },
    "bracket_type": {
      "type": "string",
      "description": "Bracket order type: SL or TP"
    },
    "context": {
      "type": "string",
      "description": "Additional context for cancellations"
    },
    "regime": {
      "type": ["string", "null"],
      "description": "Decision-time or execution-time structural regime carried additively to the order log."
    },
    "regime_confidence": {
      "type": ["number", "null"],
      "description": "Decision-time or execution-time regime confidence carried additively to the order log."
    },
    "regime_provenance": {
      "type": ["object", "null"],
      "description": "Structured detector/cache provenance block carried additively to the order log."
    },
    "strategy_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "Originating strategy identifier when the event is strategy-originated."
    },
    "decision_id": {
      "type": ["string", "null"],
      "description": "Stable decision identifier when available."
    },
    "intent_id": {
      "type": ["string", "null"],
      "description": "Stable intent identifier when available."
    },
    "confidence": {
      "type": ["number", "null"],
      "description": "Strategy signal confidence or score when available."
    },
    "schema_version": {
      "type": "string",
      "description": "Order-log telemetry schema version."
    },
    "non_financial": {
      "type": "boolean",
      "description": "True for telemetry records that must not be counted as financial/order events."
    },
    "strategies": {
      "type": "array",
      "description": "Configured and registered strategy visibility snapshot; non-financial telemetry only.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "strategy_id",
          "status",
          "plugin_file",
          "runtime_handler",
          "can_emit_order_intent",
          "configured_enabled",
          "observed_in_current_runtime",
          "notes"
        ],
        "properties": {
          "strategy_id": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": [
              "active_live",
              "configured_enabled",
              "configured_disabled",
              "shadow_only",
              "observe_only",
              "historical_or_dead_code",
              "unknown"
            ]
          },
          "plugin_file": {"type": "string"},
          "runtime_handler": {"type": "string"},
          "can_emit_order_intent": {"type": "boolean"},
          "configured_enabled": {"type": "boolean"},
          "observed_in_current_runtime": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    }
  },
  "required": ["rid", "event_type", "symbol", "source_fsm"],
  "allOf": [
    {
      "if": {
        "properties": {"event_type": {"const": "STRATEGY_REGISTRY_SNAPSHOT"}},
        "required": ["event_type"]
      },
      "then": {
        "required": ["schema_version", "non_financial", "strategies"],
        "properties": {
          "source_fsm": {"const": "OrderLoggerV1"},
          "symbol": {"const": "_SYSTEM_"},
          "non_financial": {"const": true}
        }
      }
    }
  ]
}
