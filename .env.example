# Aurora Core Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# TRADING ENVIRONMENT SELECTION
# =============================================================================
# Set to 'true' for Binance Futures TESTNET (recommended for development/testing)
# Set to 'false' for Binance Futures MAINNET (real trading with real money)
# WARNING: Mainnet trades with REAL MONEY! Use testnet for development.
USE_TESTNET=true

# =============================================================================
# BINANCE API CREDENTIALS
# =============================================================================
# For TESTNET (USE_TESTNET=true):
# - Get credentials from: https://testnet.binancefuture.com/
# - These keys work ONLY on testnet
# - Testnet has fake USDT for trading
BINANCE_TESTNET_API_KEY=YOUR_TESTNET_API_KEY
BINANCE_TESTNET_API_SECRET=YOUR_TESTNET_API_SECRET

# For MAINNET (USE_TESTNET=false):
# - Get credentials from: https://www.binance.com/ (Futures section)
# - These keys work ONLY on mainnet
# - Mainnet trades with REAL MONEY!
# - ENSURE Futures trading is ENABLED on your Binance account
# BINANCE_MAINNET_API_KEY=YOUR_MAINNET_API_KEY
# BINANCE_MAINNET_API_SECRET=YOUR_MAINNET_API_SECRET

# =============================================================================
# LOGGING & ENVIRONMENT
# =============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Trading environment identifier (for logging/metrics)
TRADING_ENV=test

# =============================================================================
# HOW TO SWITCH BETWEEN TESTNET AND MAINNET
# =============================================================================
#
# 1. For TESTNET (safe development):
#    USE_TESTNET=true
#    Use BINANCE_TESTNET_API_KEY/SECRET from testnet.binancefuture.com
#
# 2. For MAINNET (real trading):
#    USE_TESTNET=false
#    Use BINANCE_MAINNET_API_KEY/SECRET from binance.com
#    ⚠️  ENSURE you have Futures enabled and sufficient balance!
#
# 3. Restart the application after changing USE_TESTNET
#
# 4. Testnet URLs: wss://fstream.binancefuture.com (market data)
#    Mainnet URLs: wss://fstream.binance.com (market data)
#
# The system automatically switches WebSocket endpoints based on USE_TESTNET

# Trading environment
TRADING_ENV=test

# Trading environment
TRADING_ENV=dev