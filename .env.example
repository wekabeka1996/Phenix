# =============================================================================
# LIVE (MAINNET) API CREDENTIALS - For Market Data
# =============================================================================
LIVE_BINANCE_API_KEY="your_mainnet_api_key"
LIVE_BINANCE_API_SECRET="your_mainnet_api_secret"
LIVE_BINANCE_REST_URL="https://fapi.binance.com"

# =============================================================================
# TESTNET API CREDENTIALS - For Order Execution
# =============================================================================
TESTNET_BINANCE_API_KEY="your_testnet_api_key"
TESTNET_BINANCE_API_SECRET="your_testnet_api_secret"
TESTNET_BINANCE_REST_URL="https://testnet.binancefuture.com"

# =============================================================================
# TRADING MODE
# =============================================================================
# Defines the system's operational mode.
# - "live": Live data, live execution
# - "testnet": Testnet data, testnet execution
# - "hybrid_live_data_testnet_exec": Live data, testnet execution
TRADING_MODE="hybrid_live_data_testnet_exec"

# =============================================================================
# LOGGING & ENVIRONMENT
# =============================================================================
LOG_LEVEL=INFO
TRADING_ENV=dev

# =============================================================================
# GEMINI API KEY (if used)
# =============================================================================
GEMINI_API_KEY="your_gemini_api_key"
