{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aurora-trading/schemas/account_balance/events.json",
  "title": "Account Balance Domain Events Schema",
  "description": "JSON Schema для валідації FSM подій домену account_balance",
  "type": "object",

  "definitions": {

    "asset_balance": {
      "type": "object",
      "description": "Структура даних балансу активу",
      "properties": {
        "asset": {
          "type": "string",
          "description": "Назва активу (USDT, BTC, etc.)",
          "minLength": 1,
          "maxLength": 10
        },
        "balance": {
          "type": "string",
          "description": "Загальний баланс активу як рядок для точності",
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "crossUnPnl": {
          "type": "string",
          "description": "Нереалізований P&L в cross margin",
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "crossWalletBalance": {
          "type": "string",
          "description": "Баланс в cross margin",
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "updateTime": {
          "type": "integer",
          "description": "Час оновлення в мілісекундах",
          "minimum": 0
        }
      },
      "required": ["asset", "balance", "crossUnPnl", "crossWalletBalance", "updateTime"]
    },

    "position_data": {
      "type": "object",
      "description": "Структура даних відкритої позиції",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "Торгова пара (BTCUSDT)",
          "pattern": "^[A-Z]{3,10}[A-Z]{3,10}$"
        },
        "positionAmt": {
          "type": "string",
          "description": "Розмір позиції",
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "entryPrice": {
          "type": "string",
          "description": "Ціна входу в позицію",
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "unRealizedProfit": {
          "type": "string",
          "description": "Нереалізований прибуток/збиток",
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "leverage": {
          "type": "integer",
          "description": "Плече позиції",
          "minimum": 1,
          "maximum": 125
        },
        "marginType": {
          "type": "string",
          "description": "Тип маржі",
          "enum": ["isolated", "cross"]
        },
        "markPrice": {
          "type": "string",
          "description": "Позначена ціна",
          "pattern": "^\\d+(\\.\\d+)?$"
        },
        "liquidationPrice": {
          "type": "string",
          "description": "Ціна ліквідації",
          "pattern": "^\\d+(\\.\\d+)?$"
        }
      },
      "required": ["symbol", "positionAmt", "entryPrice", "unRealizedProfit", "leverage", "marginType", "markPrice", "liquidationPrice"]
    }

  },

  "oneOf": [

    {
      "title": "EVT:BALANCE_UPDATE_RECEIVED",
      "description": "Подія оновлення балансу активів рахунку",
      "type": "object",
      "properties": {
        "event_name": {
          "const": "EVT:BALANCE_UPDATE_RECEIVED"
        },
        "payload": {
          "type": "object",
          "properties": {
            "assets": {
              "type": "array",
              "description": "Масив активів з балансом > 0",
              "items": { "$ref": "#/definitions/asset_balance" },
              "minItems": 0,
              "maxItems": 1000
            },
            "updateTime": {
              "type": "integer",
              "description": "Максимальний час оновлення серед всіх активів",
              "minimum": 0
            }
          },
          "required": ["assets", "updateTime"]
        },
        "why": {
          "type": "string",
          "description": "Опис причини емісії події",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": ["event_name", "payload", "why"]
    },

    {
      "title": "EVT:ACCOUNT_UPDATE_RECEIVED",
      "description": "Подія оновлення стану рахунку та позицій",
      "type": "object",
      "properties": {
        "event_name": {
          "const": "EVT:ACCOUNT_UPDATE_RECEIVED"
        },
        "payload": {
          "type": "object",
          "properties": {
            "totalWalletBalance": {
              "type": "string",
              "description": "Загальний баланс гаманця",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            "totalUnrealizedProfit": {
              "type": "string",
              "description": "Загальний нереалізований P&L",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            "totalCrossWalletBalance": {
              "type": "string",
              "description": "Загальний cross margin баланс",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            "positions": {
              "type": "array",
              "description": "Масив відкритих позицій",
              "items": { "$ref": "#/definitions/position_data" },
              "minItems": 0,
              "maxItems": 100
            },
            "updateTime": {
              "type": "integer",
              "description": "Час оновлення в мілісекундах",
              "minimum": 0
            }
          },
          "required": ["totalWalletBalance", "totalUnrealizedProfit", "totalCrossWalletBalance", "positions", "updateTime"]
        },
        "why": {
          "type": "string",
          "description": "Опис причини емісії події",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": ["event_name", "payload", "why"]
    }

  ]}