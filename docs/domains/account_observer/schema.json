{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-trading/schemas/account_observer.json",
  "title": "Account Observer Domain Schema",
  "description": "JSON Schema для домену моніторингу торгової активності Account Observer",
  "type": "object",
  "properties": {

    "config": {
      "type": "object",
      "title": "Конфігурація домену",
      "description": "Основні налаштування домену Account Observer",
      "properties": {
        "trading_mode": {
          "type": "string",
          "enum": ["live", "testnet", "hybrid_live", "hybrid_testnet"],
          "description": "Режим роботи домену",
          "default": "live"
        },
        "poll_interval": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "description": "Інтервал опитування API в секундах",
          "default": 5
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3,10}USDT$",
            "description": "Торгова пара у форматі BASEUSDT"
          },
          "minItems": 1,
          "maxItems": 100,
          "description": "Список символів для моніторингу",
          "uniqueItems": true
        },
        "trade_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Кількість трейдів для отримання за один запит",
          "default": 50
        },
        "max_processed_trades": {
          "type": "integer",
          "minimum": 100,
          "maximum": 100000,
          "description": "Максимальна кількість кешованих ID трейдів",
          "default": 10000
        },
        "enable_metrics": {
          "type": "boolean",
          "description": "Включити збір метрик продуктивності",
          "default": true
        },
        "log_level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR"],
          "description": "Рівень логування",
          "default": "INFO"
        }
      },
      "required": ["trading_mode", "symbols"],
      "additionalProperties": false
    },

    "events": {
      "type": "object",
      "title": "Схеми подій FSM",
      "description": "Визначення всіх подій що генерує та споживає домен",

      "properties": {
        "EVT:TRADE_EXECUTED": {
          "type": "object",
          "title": "Подія виконання трейду",
          "description": "Подія що емітується при виявленні нового виконаного трейду",
          "properties": {
            "header": {
              "$ref": "#/$defs/event_header"
            },
            "payload": {
              "$ref": "#/$defs/trade_executed_payload"
            }
          },
          "required": ["header", "payload"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },

    "metrics": {
      "type": "object",
      "title": "Метрики моніторингу",
      "description": "Визначення метрик для спостереження за продуктивністю",

      "properties": {
        "trades_processed_total": {
          "type": "integer",
          "description": "Загальна кількість оброблених трейдів",
          "minimum": 0
        },
        "trades_skipped_duplicates_total": {
          "type": "integer",
          "description": "Кількість пропущених дублікатів трейдів",
          "minimum": 0
        },
        "api_calls_total": {
          "type": "integer",
          "description": "Загальна кількість викликів API",
          "minimum": 0
        },
        "api_errors_total": {
          "type": "integer",
          "description": "Кількість помилок API",
          "minimum": 0
        },
        "cached_trade_ids_count": {
          "type": "integer",
          "description": "Поточна кількість кешованих ID трейдів",
          "minimum": 0
        },
        "memory_usage_bytes": {
          "type": "integer",
          "description": "Використання пам'яті в байтах",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },

  "required": ["config"],
  "additionalProperties": false,

  "$defs": {

    "event_header": {
      "type": "object",
      "title": "Заголовок події FSM",
      "description": "Стандартний заголовок для всіх подій FSM",
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid",
          "description": "Унікальний ідентифікатор події"
        },
        "timestamp": {
          "type": "integer",
          "description": "Час створення події в мілісекундах Unix timestamp",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "const": "account_observer",
          "description": "Джерело події"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Версія схеми події",
          "default": "1.0.0"
        }
      },
      "required": ["event_id", "timestamp", "source"],
      "additionalProperties": false
    },

    "trade_executed_payload": {
      "type": "object",
      "title": "Payload події виконання трейду",
      "description": "Дані про виконану торгову операцію",
      "properties": {
        "symbol": {
          "type": "string",
          "pattern": "^[A-Z]{3,10}USDT$",
          "description": "Торгова пара"
        },
        "side": {
          "type": "string",
          "enum": ["buy", "sell"],
          "description": "Напрямок операції"
        },
        "price": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,8})?$",
          "description": "Ціна виконання як рядок для точності"
        },
        "quantity": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d{1,8})?$",
          "description": "Кількість (від'ємна для продажу)"
        },
        "ts": {
          "type": "integer",
          "description": "Час виконання в мілісекундах Unix timestamp",
          "minimum": 0
        },
        "fees": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d{1,8})?$",
          "description": "Комісія як рядок для точності"
        },
        "venue": {
          "type": "string",
          "const": "binance",
          "description": "Торговий майданчик"
        }
      },
      "required": ["symbol", "side", "price", "quantity", "ts", "fees", "venue"],
      "additionalProperties": false
    },

    "binance_trade_response": {
      "type": "object",
      "title": "Відповідь Binance API для трейду",
      "description": "Структура даних що повертає Binance API для трейду",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "Торгова пара"
        },
        "id": {
          "type": "integer",
          "description": "Унікальний ID трейду",
          "minimum": 1
        },
        "orderId": {
          "type": "integer",
          "description": "ID ордера",
          "minimum": 1
        },
        "price": {
          "type": "string",
          "description": "Ціна виконання"
        },
        "qty": {
          "type": "string",
          "description": "Кількість"
        },
        "quoteQty": {
          "type": "string",
          "description": "Загальна вартість в quote currency"
        },
        "commission": {
          "type": "string",
          "description": "Комісія"
        },
        "commissionAsset": {
          "type": "string",
          "description": "Актив комісії"
        },
        "time": {
          "type": "integer",
          "description": "Час виконання в мілісекундах",
          "minimum": 0
        },
        "isBuyer": {
          "type": "boolean",
          "description": "true для купівлі, false для продажу"
        },
        "isMaker": {
          "type": "boolean",
          "description": "true для maker ордера"
        },
        "isBestMatch": {
          "type": "boolean",
          "description": "true для найкращого співпадання"
        }
      },
      "required": ["symbol", "id", "orderId", "price", "qty", "quoteQty", "commission", "commissionAsset", "time", "isBuyer", "isMaker", "isBestMatch"],
      "additionalProperties": false
    },

    "error_response": {
      "type": "object",
      "title": "Відповідь помилки",
      "description": "Стандартна структура помилок домену",
      "properties": {
        "error_code": {
          "type": "string",
          "pattern": "^AO\\d{3}$",
          "description": "Код помилки (AO001-AO999)"
        },
        "message": {
          "type": "string",
          "description": "Опис помилки"
        },
        "timestamp": {
          "type": "integer",
          "description": "Час помилки в мілісекундах",
          "minimum": 0
        },
        "context": {
          "type": "object",
          "description": "Додатковий контекст помилки",
          "additionalProperties": true
        }
      },
      "required": ["error_code", "message", "timestamp"],
      "additionalProperties": false
    },

    "health_status": {
      "type": "object",
      "title": "Статус здоров'я домену",
      "description": "Інформація про поточний стан домену",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["healthy", "degraded", "unhealthy"],
          "description": "Загальний статус"
        },
        "uptime_seconds": {
          "type": "integer",
          "description": "Час роботи в секундах",
          "minimum": 0
        },
        "last_api_call": {
          "type": "integer",
          "description": "Час останнього успішного виклику API",
          "minimum": 0
        },
        "active_symbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Список активних символів"
        },
        "cached_trades_count": {
          "type": "integer",
          "description": "Кількість кешованих ID трейдів",
          "minimum": 0
        },
        "error_rate_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Відсоток помилок за останній період"
        }
      },
      "required": ["status", "uptime_seconds"],
      "additionalProperties": false
    }
  }
}