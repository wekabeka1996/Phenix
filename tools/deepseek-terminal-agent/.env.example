# ─── DeepSeek API ────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-b2034edb57a44a6397f951097ebf8d01
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REQUEST_TIMEOUT_SEC=300
DEEPSEEK_REASONING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=high

# ─── Agent / Terminal Tool ────────────────────────────────────────────────────
AGENT_WORKSPACE=/workspace/project
AGENT_MAX_ITERATIONS=20
AGENT_COMMAND_TIMEOUT_SEC=120
AGENT_MAX_COMMAND_OUTPUT_CHARS=20000
AGENT_REQUIRE_APPROVAL_FOR_DANGEROUS=true
AGENT_ALLOW_NETWORK=true

# ─── Dashboard (optional) ─────────────────────────────────────────────────────
# WARNING: changing DASHBOARD_HOST to 0.0.0.0 exposes dashboard on the network.
# Only do this behind a firewall/VPN with no public access.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
