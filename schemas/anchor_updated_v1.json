{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aurora.internal/schemas/anchor_updated_v1.json",
  "title": "EVT:ANCHOR_UPDATED payload schema",
  "description": "Anchor price update emitted by market_data for macro-sync pipelines.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anchor",
    "price",
    "ts_ms"
  ],
  "properties": {
    "anchor": {
      "type": "string",
      "minLength": 1,
      "description": "Anchor instrument identifier (e.g., BTCUSDT)."
    },
    "price": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        {
          "type": "number"
        }
      ],
      "description": "Anchor price as decimal-compatible value."
    },
    "ts_ms": {
      "type": "integer",
      "minimum": 1,
      "description": "Exchange-derived event timestamp in milliseconds."
    }
  }
}
