{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/config/trading_schema.json",
  "title": "Trading Configuration Schema",
  "description": "Schema for the trading.yaml configuration file, including risk management data sources.",
  "type": "object",
  "properties": {
    "trading": {
      "type": "object",
      "properties": {
        "risk_management": {
          "type": "object",
          "properties": {
            "data_sources": {
              "type": "object",
              "properties": {
                "portfolio_state": {
                  "type": "string",
                  "enum": ["live", "testnet", "follow_execution"],
                  "default": "follow_execution",
                  "description": "Source for portfolio state data for risk management. 'follow_execution' means it follows the execution domain's trading mode."
                },
                "market_data": {
                  "type": "string",
                  "enum": ["live", "testnet"],
                  "default": "live",
                  "description": "Reference for market data source for risk management (informational, does not affect current pipeline)."
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}