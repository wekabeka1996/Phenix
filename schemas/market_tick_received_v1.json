{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phenix.aurora/schemas/market_tick_received_v1.json",
  "title": "EVT:MARKET_TICK_RECEIVED Payload",
  "description": "Real-time market tick event payload emitted by market_data domain",
  "type": "object",
  "required": [
    "ts",
    "symbol",
    "price",
    "bid",
    "ask",
    "mid",
    "bid_size",
    "ask_size",
    "buy_volume",
    "sell_volume",
    "data_type",
    "data_source"
  ],
  "properties": {
    "ts": {
      "type": "integer",
      "description": "Unix timestamp in milliseconds",
      "minimum": 0,
      "examples": [1700000000000]
    },
    "symbol": {
      "type": "string",
      "description": "Trading pair symbol (e.g., BTCUSDT, SOLUSDT, 1000PEPEUSDT)",
      "pattern": "^[A-Z0-9]{2,20}USDT$",
      "examples": ["BTCUSDT", "ETHUSDT", "SOLUSDT", "1000PEPEUSDT"]
    },
    "price": {
      "type": "string",
      "description": "Latest trade price as string decimal",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "examples": ["50000.00", "100.55"]
    },
    "bid": {
      "type": "string",
      "description": "Best bid price as string decimal",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "examples": ["49999.50"]
    },
    "ask": {
      "type": "string",
      "description": "Best ask price as string decimal",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "examples": ["50000.50"]
    },
    "mid": {
      "type": "string",
      "description": "Mid price = (bid + ask) / 2 as string decimal",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "examples": ["50000.00"]
    },
    "bid_size": {
      "type": "string",
      "description": "Best bid quantity as string decimal (for OBI calculation)",
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "examples": ["10.5", "100"]
    },
    "ask_size": {
      "type": "string",
      "description": "Best ask quantity as string decimal (for OBI calculation)",
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "examples": ["8.3", "95"]
    },
    "buy_volume": {
      "type": "string",
      "description": "Number of buy trades in window as string (for TFI calculation)",
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "examples": ["50", "120"]
    },
    "sell_volume": {
      "type": "string",
      "description": "Number of sell trades in window as string (for TFI calculation)",
      "pattern": "^[0-9]+(\\.[0-9]+)?$",
      "examples": ["45", "80"]
    },
    "data_type": {
      "type": "string",
      "description": "Type of market data aggregation",
      "enum": ["market_tick_aggregated", "kline_1m"],
      "examples": ["market_tick_aggregated"]
    },
    "data_source": {
      "type": "string",
      "description": "Source environment for the data",
      "enum": ["live", "testnet", "websocket_live", "multiprocess_worker"],
      "examples": ["websocket_live", "testnet"]
    },
    "buy_count": {
      "type": ["integer", "null"],
      "description": "Number of buy trades in aggregation window"
    },
    "sell_count": {
      "type": ["integer", "null"],
      "description": "Number of sell trades in aggregation window"
    },
    "buy_notional": {
      "type": ["string", "null"],
      "description": "Buy-side notional volume as string decimal",
      "examples": ["12345.67"]
    },
    "sell_notional": {
      "type": ["string", "null"],
      "description": "Sell-side notional volume as string decimal",
      "examples": ["9876.54"]
    },
    "trades_dropped_out_of_order": {
      "type": ["integer", "null"],
      "description": "Count of trades dropped due to out-of-order timestamps"
    },
    "trade_flow_state": {
      "type": ["string", "null"],
      "enum": ["unknown", "fresh", "degraded", "stale", null],
      "description": "Trade-flow freshness state based on latest observed trade age"
    },
    "trade_flow_age_ms": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Age of the latest observed trade in milliseconds"
    },
    "trade_flow_last_trade_ts_ms": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Exchange timestamp of the latest observed trade"
    },
    "trade_flow_window_sec": {
      "type": ["integer", "null"],
      "minimum": 1,
      "description": "Trade-flow aggregation window in seconds"
    },
    "features": {
      "type": "object",
      "description": "Computed microstructure features (OBI, TFI, delta_price, absorption)",
      "additionalProperties": true
    },
    "bid_ask_count": {
      "type": "string",
      "description": "Human-readable bid/ask size summary"
    },
    "trade_count": {
      "type": "string",
      "description": "Human-readable buy/sell trade count summary"
    },
    "debug_info": {
      "type": "string",
      "description": "Optional debug information for logging",
      "examples": ["BID/ASK: 10/8, Trades: BUY:50 SELL:45"]
    }
  },
  "additionalProperties": false
}
