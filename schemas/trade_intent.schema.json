{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.scalp/shared/dto/trade_intent.schema.json",
  "title": "TradeIntent",
  "type": "object",
  "required": [
    "instrument",
    "side",
    "idempotent_key",
    "p",
    "payoff_ratio_r",
    "tca_budget",
    "risk_budget",
    "size",
    "order",
    "valid_for_ms",
    "why",
    "dto_version",
    "schema_ref"
  ],
  "additionalProperties": false,
  "properties": {
    "instrument": {
      "type": "string",
      "pattern": "^[A-Z]{3,10}USDT$"
    },
    "side": {
      "type": "string",
      "enum": ["BUY", "SELL"]
    },
    "idempotent_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36,
      "description": "SHA256 hash of symbol:side:timestamp for order deduplication"
    },
    "p": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Probability of success as decimal string"
    },
    "payoff_ratio_r": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Payoff ratio as decimal string"
    },
    "tca_budget": {
      "type": "object",
      "required": ["max_slippage_bps", "max_latency_ms", "maker_preference"],
      "additionalProperties": false,
      "properties": {
        "max_slippage_bps": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "max_latency_ms": {
          "type": "integer",
          "minimum": 1
        },
        "maker_preference": {
          "type": "string",
          "enum": ["prefer", "avoid", "neutral"]
        }
      }
    },
    "risk_budget": {
      "type": "object",
      "required": ["trade_cvar95_max_bps", "session_cvar95_max_bps"],
      "additionalProperties": false,
      "properties": {
        "trade_cvar95_max_bps": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "session_cvar95_max_bps": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        }
      }
    },
    "size": {
      "type": "object",
      "required": ["kelly_fraction", "notional_cap_usd"],
      "additionalProperties": false,
      "properties": {
        "kelly_fraction": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "notional_cap_usd": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        }
      }
    },
    "order": {
      "type": "object",
      "required": ["price_ref", "qty", "price", "reduce_only"],
      "additionalProperties": false,
      "properties": {
        "price_ref": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "qty": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "price": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$"
        },
        "reduce_only": {
          "type": "boolean"
        }
      }
    },
    "valid_for_ms": {
      "type": "integer",
      "minimum": 1
    },
    "why": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "dto_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "schema_ref": {
      "type": "string",
      "format": "uri"
    }
  }
}