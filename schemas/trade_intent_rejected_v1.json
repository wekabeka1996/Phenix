{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aurora.internal/schemas/trade_intent_rejected_v1.json",
  "title": "EVT:TRADE_INTENT_REJECTED payload schema",
  "description": "SSOT reject event for missed opportunities (why we did NOT open).",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts_ms", "symbol", "reason_code", "stage", "why"],
  "properties": {
    "ts_ms": {
      "type": "integer",
      "description": "Event timestamp in milliseconds"
    },
    "symbol": {
      "type": "string"
    },
    "tf_sec": {
      "type": "integer",
      "minimum": 0,
      "description": "Timeframe context; 0 is allowed only for legacy/tick contexts"
    },
    "bar_close_ts": {
      "type": "integer",
      "description": "Bar close timestamp in ms (when bar context exists)"
    },
    "reason_code": {
      "type": "string",
      "description": "Normalized SSOT reason code (NRR/contract codes only)"
    },
    "strategy_id": {
      "type": "string",
      "description": "Strategy identifier (if known)"
    },
    "side": {
      "type": "string",
      "enum": ["buy", "sell"],
      "description": "Intended side (if known)"
    },
    "rid": {
      "type": "string",
      "description": "Correlation / request id (if known)"
    },
    "stage": {
      "type": "string",
      "enum": ["RISK", "STRATEGY", "DECISION", "EXECUTION"],
      "description": "Pipeline stage that rejected the opportunity"
    },
    "why": {
      "type": "string",
      "maxLength": 240,
      "description": "Short human-readable explanation (not a full stacktrace)"
    },
    "context": {
      "type": "string",
      "description": "Short context tag for where the reject happened"
    },
    "why_chain": {
      "type": "array",
      "items": {"type": "string"}
    },
    "details": {
      "type": "object",
      "description": "Optional structured details (lightweight)",
      "additionalProperties": true,
      "properties": {
        "anti_peak_observability": {
          "type": ["object", "null"],
          "additionalProperties": true,
          "properties": {
            "enabled": {"type": ["boolean", "null"]},
            "gate_disabled": {"type": ["boolean", "null"]},
            "motion_classification": {"type": ["string", "null"]},
            "missing_inputs": {
              "type": ["object", "null"],
              "additionalProperties": {"type": ["string", "null"]}
            },
            "active_config": {"type": ["object", "null"], "additionalProperties": true},
            "disabled_config_snapshot": {"type": ["object", "null"], "additionalProperties": true},
            "anti_fomo_sigma": {"type": ["number", "null"]},
            "anti_flat_sigma": {"type": ["number", "null"]},
            "window_sec": {"type": ["integer", "null"]},
            "anti_fomo_sigma_value_source": {"type": ["string", "null"]},
            "anti_flat_sigma_value_source": {"type": ["string", "null"]},
            "window_sec_value_source": {"type": ["string", "null"]},
            "motion_norm_sigma": {"type": ["number", "null"]},
            "score_before_shields": {"type": ["number", "null"]},
            "score_after_shields": {"type": ["number", "null"]},
            "final_score": {"type": ["number", "null"]},
            "signal_threshold": {"type": ["number", "null"]},
            "danger_zone_applied": {"type": ["boolean", "null"]},
            "context_shield_applied": {"type": ["boolean", "null"]},
            "attenuated_below_threshold": {"type": ["boolean", "null"]},
            "consumed_by_gate": {"type": ["boolean", "null"]},
            "source": {"type": ["string", "null"]},
            "ready": {"type": ["boolean", "null"]},
            "reason": {"type": ["string", "null"]}
          }
        }
      }
    },
    "entry_plan": {
      "type": "object",
      "description": "Optional lightweight trace of entry plan",
      "additionalProperties": true
    }
  }
}
