{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision_trace_emitted_v1.json",
  "title": "Decision Trace Emitted (Monitoring Only)",
  "description": "Schema for EVT:DECISION_TRACE_EMITTED payload. Emitted by decision_making for forensic traceability (DM-DIR-FORENSIC-01).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rid": {
      "type": "string",
      "description": "Causal request id shared with signal, gateway, and downstream artifacts"
    },
    "decision_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonical decision identifier when the upstream strategy path provides one"
    },
    "cycle_key": {
      "type": [
        "string",
        "null"
      ],
      "description": "Canonical review/replay cycle identity when propagated from upstream"
    },
    "lifecycle_id": {
      "type": "string",
      "description": "Lifecycle/idempotent key for allowed intents when available"
    },
    "intent_id": {
      "type": "string",
      "description": "Intent identifier for accepted traces; mirrors lifecycle_id on the hot path"
    },
    "symbol": {
      "type": "string",
      "description": "Trading symbol (e.g., SOLUSDT)"
    },
    "side": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "BUY",
        "SELL",
        null
      ],
      "description": "Raw order-side when available"
    },
    "strategy_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Strategy identifier associated with the decision trace"
    },
    "ts": {
      "type": "integer",
      "description": "Decision timestamp in ms epoch"
    },
    "event_ts_ms": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Decision event timestamp in ms epoch"
    },
    "tf_sec": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Decision timeframe in seconds when available"
    },
    "bar_close_ts_ms": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Bar close timestamp in ms epoch when available"
    },
    "intent_side": {
      "type": "string",
      "enum": [
        "LONG",
        "SHORT"
      ],
      "description": "Intent direction as position side"
    },
    "signal_score": {
      "type": [
        "number",
        "null"
      ],
      "description": "Signal score if available"
    },
    "raw_score": {
      "type": [
        "number",
        "null"
      ],
      "description": "Raw strategy score when propagated from upstream strategy trace"
    },
    "decision_score": {
      "type": [
        "number",
        "null"
      ],
      "description": "Decision-stage score when propagated from upstream strategy trace"
    },
    "active_threshold": {
      "type": [
        "number",
        "null"
      ],
      "description": "Threshold active for the current decision when available"
    },
    "score_to_threshold_ratio": {
      "type": [
        "number",
        "null"
      ],
      "description": "Decision score to threshold ratio when available"
    },
    "score_lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "scale": {
                "type": "string"
              },
              "producer": {
                "type": "string"
              },
              "consumer_stage": {
                "type": "string"
              },
              "threshold_family": {
                "type": "string"
              },
              "live_authority_status": {
                "type": "string"
              },
              "compatibility_alias_for": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "post_objective_override": {
                "type": "boolean"
              }
            },
            "required": [
              "field",
              "value",
              "scale",
              "producer",
              "consumer_stage",
              "threshold_family",
              "live_authority_status",
              "compatibility_alias_for",
              "post_objective_override"
            ]
          }
        }
      },
      "required": [
        "path",
        "records"
      ]
    },
    "decision_surface": {
      "type": "string",
      "description": "Logical surface that produced the canonical decision trace row"
    },
    "gate_chain_result": {
      "type": "string",
      "description": "Top-level gate-chain result for the decision trace"
    },
    "accepted_or_rejected": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "REJECTED"
      ],
      "description": "Canonical accepted/rejected classification for ledger seeding"
    },
    "reject_reason": {
      "type": [
        "string",
        "null"
      ],
      "description": "Reject reason for denied traces when available"
    },
    "regime": {
      "type": [
        "string",
        "null"
      ],
      "description": "Detected regime if available"
    },
    "regime_confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1,
      "description": "Regime confidence if available"
    },
    "resolved_regime_confidence_strategy_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_regime_confidence_symbol": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_regime_confidence_regime_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "min_regime_confidence": {
      "type": [
        "number",
        "null"
      ]
    },
    "resolved_min_regime_confidence": {
      "type": [
        "number",
        "null"
      ]
    },
    "resolved_min_regime_confidence_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_min_regime_confidence_strategy_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_min_regime_confidence_regime_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_max_regime_confidence": {
      "type": [
        "number",
        "null"
      ]
    },
    "resolved_max_regime_confidence_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_max_regime_confidence_strategy_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_max_regime_confidence_regime_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved_regime_confidence_band_active": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "regime_confidence_breach_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "regime_confidence_gate_verdict": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "ALLOW",
        "DENY",
        "BYPASS",
        null
      ],
      "description": "Directional sanity regime-confidence gate verdict when available"
    },
    "trend_dir": {
      "type": "string",
