                      ]
                    },
                    "pre_cutoff_clamped_to_max": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "pre_cutoff_boundary_reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "uncertain_cutoff": {
                      "type": [
                        "number",
                        "string",
                        "null"
                      ]
                    },
                    "demoted_to_uncertain": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "raw_regime": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "raw_confidence": {
                      "type": [
                        "number",
                        "string",
                        "null"
                      ]
                    },
                    "raw_boundary_reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "hysteresis_bars": {
                      "type": [
