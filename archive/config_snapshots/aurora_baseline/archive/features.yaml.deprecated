# Feature Engineering Domain Configuration
# =========================================
# This file defines all parameters for feature calculation in QuantumTraderX.
# All features are normalized to [0,1] or [-1,1] ranges.
#
# Features computed:
# - Base: OBI, TFI, delta_price, liquidity_kappa, absorption (placeholder)
# - Phase 1: ema_bias, volume_spike, volatility_state, depth_imbalance, macro_sync

feature_engineering:
  # Master switch for Phase 1 metrics
  # When false, only base features (OBI, TFI, delta_price) are computed
  enable_new_metrics: true

  # ============================================================================
  # EMA Configuration (for ema_bias calculation)
  # ============================================================================
  # Formula: ema_bias = (EMA_short - EMA_long) / EMA_long
  # Output: Normalized to [0, 1] where 0.5 = neutral, >0.5 = bullish, <0.5 = bearish
  ema:
    period_short: 3      # Short EMA period (must be > 0, < period_long)
    period_long: 7       # Long EMA period (must be > period_short)
    # Note: Alpha = 2 / (period + 1), so EMA3_alpha = 0.5, EMA7_alpha = 0.25

  # ============================================================================
  # EMA Bias Normalization
  # ============================================================================
  # Raw bias is clamped to [clamp_min, clamp_max] then linearly mapped to [0, 1]
  ema_bias:
    clamp_min: -0.02     # -2% = full bearish (maps to 0.0)
    clamp_max: 0.02      # +2% = full bullish (maps to 1.0)

  # ============================================================================
  # Volume Spike Configuration
  # ============================================================================
  # Formula: spike = current_window_volume / SMA(historical_volumes, sma_length)
  # Output: Capped at cap_max, then normalized to [0, 1]
  volume:
    window_sec: 60       # Aggregation window in seconds (1-3600)
    sma_length: 5        # SMA periods for baseline (2-100)

  volume_spike:
    cap_max: 3.0         # Maximum spike ratio (3.0 = 300% of average)
                         # Higher values detected but capped for normalization

  # ============================================================================
  # Volatility State Configuration
  # ============================================================================
  # Formula: state = current_range / SMA(historical_ranges, sma_length)
  # Output: Capped and normalized to [0, 1]
  volatility:
    window_sec: 60       # Price range window in seconds (1-3600)
    sma_length: 10       # SMA periods for baseline (2-100)

  volatility_state:
    cap_max: 3.0         # Maximum volatility ratio cap

  # ============================================================================
  # Liquidity Configuration
  # ============================================================================
  # Used by:
  # - liquidity_kappa: kappa = depth / (depth + depth_half), clamped to [kappa_min, kappa_max]
  # - depth_imbalance: ratio = (asks + depth_half) / (bids + depth_half)
  liquidity:
    depth_half: 1000.0   # Half-depth smoothing parameter (USD or contracts)
                         # Higher = less sensitive to depth changes
    kappa_min: 0.3       # Minimum kappa (even low liquidity gets 0.3)
    kappa_max: 1.0       # Maximum kappa

  depth_imbalance:
    use_laplace_smoothing: true  # Use depth_half for smoothing

  # ============================================================================
  # Delta Price Configuration
  # ============================================================================
  # Formula: delta_price = current_price - previous_price
  # Spike filter: If time gap > spike_filter_ms, delta_price = 0
  delta_price:
    spike_filter_ms: 5000  # 5 seconds - filter reconnection artifacts

  # ============================================================================
  # Macro Sync Configuration
  # ============================================================================
  # Formula: macro_sync = mean(Pearson(symbol_returns, anchor_returns))
  # Output: Normalized from [-1, 1] to [0, 1]
  macro_sync:
    enabled: true                         # Enable correlation calculation
    anchors:                              # Market leaders for correlation
      - "BTCUSDT"
      - "ETHUSDT"
    window: 60                            # Rolling window size (returns)
    min_buffer_size: 3                    # Minimum samples before computing
    time_diff_threshold_ms: 5000          # Max time gap for return calc

  # ============================================================================
  # Default/Neutral Values Configuration
  # ============================================================================
  # These values are returned when insufficient data or edge cases occur.
  # All features normalized to [0, 1], so 0.5 = neutral/center.
  defaults:
    neutral_value: 0.5                    # Center of [0,1] range
    zero_value: 0.0                       # For absent features (absorption placeholder)
    correlation_default: 0.0              # Default Pearson correlation when no data
    ms_per_sec: 1000                      # Conversion constant (seconds → ms)

# ============================================================================
# Legacy paths (for backward compatibility)
# ============================================================================
# The system also checks these paths if domains.feature_engineering is not found:
# - trading.feature_engineering
# - trading.market_data.macro_sync (for macro_sync config)

# ============================================================================
# FUTURES FEATURES (FTR-05)
# ============================================================================
# Futures-specific features: funding rate, open interest
# These require EVT:FUNDING_UPDATE and EVT:OI_UPDATE events from data provider

  futures:
    enabled: true                         # FTR-10: Enabled for futures features
    
    funding:
      extreme_threshold: 0.001            # 0.1% - funding rates beyond this are "extreme"
                                          # Used to normalize funding to [-1, 1]
                                          # Examples:
                                          #   funding = 0.0005 (0.05%) → normalized = 0.5
                                          #   funding = 0.001 (0.1%) → normalized = 1.0 (clamped)
                                          #   funding = -0.0003 → normalized = -0.3
